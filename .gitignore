# OS / sync junk
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

# Editor
.vscode/
.idea/

# Astro / Node
node_modules/
dist/
.astro/
.cache/
*.log
.env
.env.production

# Локальные хелперы (только для машины Николая)
_*.bat

# Local backups of original (pre-optimized) image assets — not for repo
assets/**/original/

# Исходные макеты кейсов — только на машине Николая. Из cases/ в репозиторий
# идут лишь case.md и gallery.yaml; картинки для сайта нарезаются
# в public/assets/cases/<slug>/. Правило от обратного: у кейсов нет единой
# папки с исходниками — где-то Raw/, где-то raw/, где-то файлы в корне.
# Папки кейсов лежат в группах published/ и unpublished/, отсюда лишний уровень
# в путях. Первый уровень тоже оставлен: кейс, забытый в корне cases/, все равно
# попадет в репозиторий, а не потеряется молча.
cases/**
!cases/*/
!cases/*/case.md
!cases/*/gallery.yaml
!cases/*/*/
!cases/*/*/case.md
!cases/*/*/gallery.yaml

# Рабочая папка пайплайна кейсов. В репозиторий идут только скрипты нарезки
# и конфиги с координатами резов — по ним кейс можно перенарезать заново.
# Выхлоп (превью-полосы, распакованные макеты, черновые заметки) — локально.
tmp/**
!tmp/*.mjs
!tmp/slices/
!tmp/slices/*.json
