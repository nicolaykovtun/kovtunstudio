---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WhatGrid from '../components/WhatGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ReturningClients from '../components/ReturningClients.astro';
import FounderSection from '../components/FounderSection.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
