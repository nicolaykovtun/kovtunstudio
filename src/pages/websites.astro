// Объем на карточке взят из ключевых фактов кейса и записан здесь: в шапке
// кейса этих строк нет.
const caseMetaBySlug: Record<string, string> = {
  'website-green-power': '12 блоков · заказ в Телеграм-бот',
  'website-trubovarnya': '6 страниц · 6 вайрфреймов',
  'website-ptksk': '9 блоков · 2 сценария заявки',
  'website-eon-phuket': '11 вайрфреймов · 4 формата доступа',
  'website-greatway': '11 страниц · расчет на 8 из них',
  'website-japan-shina': '3 формы подбора',
  'website-kapital-inform': '8 страниц · 6 услуг на одном шаблоне',
  'website-b2b-cosmetics': '9 страниц · 5 брендов на шаблоне',
  'website-kuznitsa-dushi': 'Программа по дням · цена по составу',
  'website-ektostroy': 'Цена и бригада до заявки',
  'website-evg-group': 'Лендинг для инвесторов',
};

const webCases = (await getCollection('cases', ({ data }) => !data.draft))
  .filter((entry) => directionByCategory[entry.data.category] === 'web')
  .filter((entry) => Boolean(entry.data.gallery))
  .sort((a, b) => caseOrderIndex(a.id) - caseOrderIndex(b.id))
  .map((entry) => {
    const c = entry.data;
    return {
      slug: c.slug,
      title: c.shortTitle || c.client,
      meta: [caseMetaBySlug[c.slug], c.segmentLabel].filter(Boolean).join(' · '),
      coverSrc: `${c.gallery.assetRoot}/${c.gallery.cover.src}`,
      coverAlt: c.gallery.cover.alt,
    };
  });

// На странице показываем три кейса, по одному на тип сайта: лендинг,
// корпоративный, B2B-каталог. Остальные — по кнопке в портфолио. В схему
// ItemList уходят все кейсы направления.
const featuredWebSlugs = ['website-ptksk', 'website-kapital-inform', 'website-b2b-cosmetics'];
const webFeatured = featuredWebSlugs
  .map((slug) => webCases.find((item) => item.slug === slug))
  .filter((item): item is (typeof webCases)[number] => Boolean(item));

// Счетчик в hero считается по кейсам, а не пишется руками.
const plural = (n: number, one: string, few: string, many: string) => {
  const mod100 = n % 100;
  const mod10 = n % 10;
  if (mod100 >= 11 && mod100 <= 14) return many;
  if (mod10 === 1) return one;
  if (mod10 >= 2 && mod10 <= 4) return few;
  return many;
};

