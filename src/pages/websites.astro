  title: 'Проект ведет<br>один дизайнер',
  aside:
    'Текст, структуру, дизайн и сборку делает один человек. Поэтому на четвертой неделе не выясняется, что задумка не верстается, а текст не помещается в блок.',
  name: site.founderSection.name,
  role: site.founderSection.role,
  image: site.founderSection.image,
  imageAlt: site.founderSection.imageAlt,
  text:
    'В дизайне с 2010 года. Сайты веду полным циклом: сам пишу тексты, собираю структуру, рисую макеты и верстаю на WordPress. Если задача больше сайта, говорю об этом на брифе.',
  stats: [
    { num: '2010', label: 'Год начала работы дизайнером' },
    { num: '4', label: 'Этапа, каждый утверждается отдельно' },
  ],
  points: [
    {
      num: '01',
      title: 'Один контакт',
      text: 'Общаетесь напрямую с дизайнером, без пересказа задачи через менеджера.',
    },
    {
      num: '02',
      title: 'Тексты мои',
      text: 'Не жду от вас готовых текстов: заголовки и описания пишу сам и согласовываю до дизайна.',
    },
    {
      num: '03',
      title: 'Честная граница',
      text: 'Если задаче нужна техническая команда, вы узнаете это до старта.',
    },
    {
      num: '04',
      title: 'Сайт остается вашим',
      text: 'WordPress, домен и хостинг оформлены на вас — вести сайт дальше можно с кем угодно.',
    },
  ],
};

const contactData = {
  title: 'Обсудим ваш сайт',
  intro: 'Пришлите задачу и список разделов, вернусь со сметой в день брифа.',
  telegramTitle: 'Написать в Telegram',
  maxTitle: 'Написать в MAX',
  formTitle: 'Расскажите о задаче',
  fields: {
    name: { label: 'Имя', placeholder: 'Как к вам обращаться', error: 'Как к вам обращаться?' },
    car: {
      label: 'Компания и тип сайта',
      placeholder: 'Например: монтаж отопления, нужен сайт на 6 страниц',
      error: 'Сфера и примерный объем — чтобы прикинуть тип сайта',
      msgLabel: 'Компания и тип сайта',
    },
    contact: {
      label: 'Куда ответить',
      placeholder: 'Телефон, почта или ник в Telegram',
      error: 'Куда вам ответить? Телефон, почта или ник.',
    },
    message: {
      label: 'Разделы и материалы (необязательно)',
      placeholder: 'Список разделов, текущий сайт, примеры, которые нравятся',
    },
  },
  privacy: 'Заявка попадает в мою CRM и больше никуда. Как я обращаюсь с данными, написано в политике обработки.',
  submit: 'Отправить заявку',
  successTitle: 'Заявка отправлена',
  successText: 'Отвечу в течение пары часов на контакт из заявки. Если удобнее переписка, ниже готовый текст для Telegram или MAX.',
  successNote: 'В Telegram сообщение подставится само. Для MAX текст скопируется в буфер, вставьте его в чат.',
  errorText: 'Заявка не ушла: сервер не ответил. Напишите мне напрямую, текст заявки уже собран:',
  resetText: 'Отправить еще одну заявку',
};

const footer = {
  ...site.footer,
  columns: [
    {
      title: 'Страница',
      links: [
        { href: '#scope', label: 'Границы' },
        { href: '#types', label: 'Типы сайтов' },
        { href: '#pricing', label: 'Цены' },
        { href: '#tasks', label: 'Задачи' },
        { href: '#cases', label: 'Кейсы' },
        { href: '#faq', label: 'FAQ' },
      ],
    },
    site.footer.columns[1],
    {
      title: 'Прочее',
      links: [
        { href: '/', label: 'Главная' },
        { href: '/portfolio/', label: 'Портфолио' },
        { href: '/identity/', label: 'Фирменный стиль' },
        { href: '/packaging/', label: 'Упаковка' },
        { href: '/presentations/', label: 'Презентации' },
        { href: '/car-wrap/', label: 'Оклейка авто' },
        { href: '/blog/', label: 'Мысли' },
        { href: '#contact', label: 'Оставить заявку' },
      ],
    },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/websites/#service`,
  name: 'Разработка сайтов под ключ',
  serviceType: 'Разработка и дизайн сайтов',
  description:
    'Лендинги, корпоративные сайты и B2B-каталоги под ключ: текст, структура и вайрфрейм, дизайн, верстка на WordPress, адаптив, базовое SEO, формы заявок, домен и хостинг.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'Country', name: 'Россия' },
  audience: { '@type': 'BusinessAudience', audienceType: site.business.serviceAudience },
  offers: [
    { '@type': 'Offer', name: 'Лендинг под ключ', price: '120000', priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Корпоративный сайт под ключ', price: '220000', priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'B2B-сайт и каталог под ключ', price: '350000', priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Дополнительная страница сайта', price: '15000', priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Поддержка и правки сайта, в месяц', price: '25000', priceCurrency: 'RUB' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const ldPortfolioCases = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${site.url}/websites/#portfolio`,
  name: 'Кейсы разработки сайтов Kovtun.studio',
  url: `${site.url}/websites/`,
  numberOfItems: webCases.length,
  itemListElement: webCases.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: item.title,
      url: `${site.url}/cases/${item.slug}/`,
      image: `${site.url}${item.coverSrc}`,
      creator: { '@id': `${site.url}/#business` },
    },
  })),
};
---

<BaseLayout
  title="Разработка сайтов под ключ на WordPress · Kovtun.studio"
  description="Лендинг от 120 000 ₽, корпоративный сайт от 220 000 ₽, B2B-каталог от 350 000 ₽. Текст, структура, дизайн и сборка. Четыре этапа, каждый утверждается."
  keywords="разработка сайта, заказать сайт, лендинг под ключ, корпоративный сайт, B2B сайт, каталог, сайт на WordPress, Владивосток"
  canonicalPath="/websites/"
  ogImage="/og-websites.jpg"
  ogImageAlt="Главный экран сайта ПТК «Стройконструкция»"
  ogTitle="Разработка сайтов под ключ — от текста до запуска"
  ogDescription="Лендинг от 120 000 ₽, корпоративный сайт от 220 000 ₽, B2B-каталог от 350 000 ₽. Текст и структура согласуются до дизайна."
  structuredData={[serviceLd, faqLd, ldPortfolioCases]}
>
  <Header nav={nav} phone={site.contact.phone} phoneTel={site.contact.phoneTel} telegramUrl={site.contact.telegram} maxUrl={site.contact.max} />

  <main id="main-content">
    <div class="websites-hero-wrap">
      <Hero {...hero} />
    </div>
    <Marquee {...marquee} />

    <section class="section" id="scope">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2 set:html={boundary.title}></h2>
          </div>
          <p class="aside">{boundary.aside}</p>
        </div>

        <div class="boundary-grid">
          <article class="boundary-card boundary-card--take">
            <span class="boundary-kicker">{boundary.take.kicker}</span>
            <h3>{boundary.take.title}</h3>
            <ul>
              {boundary.take.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <article class="boundary-card boundary-card--skip">
            <span class="boundary-kicker">{boundary.skip.kicker}</span>
            <h3>{boundary.skip.title}</h3>
            <ul>
              {boundary.skip.items.map((item) => <li>{item}</li>)}
            </ul>
            <p class="boundary-note">{boundary.skip.note}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-tight" id="types">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2>Три типа задачи —<br>три разных объема</h2>
          </div>
          <p class="aside">Тип выбирается не по размеру компании, а по тому, сколько разных разговоров нужно вести с клиентом и сколько у него сценариев выбора.</p>
        </div>
        <div class="scenario-grid">
          {types.map((item) => (
            <article class:list={['scenario-card', { 'is-featured': item.featured }]}>
              <div class="scenario-card__top">
                <span class="scenario-num">{item.num}</span>
                {item.featured && <span class="scenario-badge">Самый частый случай</span>}
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a href={`#package-${item.num}`}>Смотреть, что входит <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="approach-wrap">
      <WhatGrid {...approach} />
    </div>

    <section class="section presentations-pricing" id="pricing">
      <div class="container-wide">
        <div class="section-head">
          <h2>Три формата под ключ —<br>и отдельные этапы</h2>
          <p class="aside">Цена зависит от количества страниц, нестандартных блоков, объема контента и интеграций. Точную смету считаю после брифа.</p>
        </div>

        <article class="audit-card">
          <div class="audit-card__badge">{stage.badge}</div>
          <div class="audit-card__body">
            <h3>{stage.title}</h3>
            <p>{stage.text}</p>
            <ul>
              {stage.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="audit-card__offer">
            <strong>{stage.price}</strong>
            <span>{stage.term}</span>
            <a class="btn btn-primary" href="#contact" data-package="Отдельный этап">
              Обсудить этап <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <div class="package-grid">
          {packages.map((item) => (
            <article class:list={['package-card', { 'is-featured': item.featured }]} id={`package-${item.num}`}>
              <div class="package-card__head">
                <span>{item.num}</span>
                {item.featured && <b>Чаще всего</b>}
              </div>
              <h3>{item.title}</h3>
              <div class="package-price">{item.price}</div>
              <p class="package-detail">{item.detail}</p>
              <ul>
                {item.items.map((entry) => <li>{entry}</li>)}
              </ul>
              <a class:list={['btn', item.featured ? 'btn-primary' : 'btn-dark']} href="#contact" data-package={item.title}>
                Выбрать формат <span class="arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>

        <p class="rate-note">
          После запуска: дополнительная страница по готовому шаблону — 15 000 ₽ и три дня,
          регулярные правки и обновления — поддержка от 25 000 ₽ в месяц. Оба пункта
          по желанию: тексты и картинки вы правите сами.
        </p>
        <p class="rate-note">
          Не уверены, какой тип ваш? Пришлите список разделов в
          <a href={site.contact.telegram} target="_blank" rel="noopener">Telegram</a> —
          скажу, лендинг это или уже корпоративный сайт, и назову вилку. Без обязательств.
          Если стиля еще нет, его можно <a href="/identity/">сделать до сайта</a>.
        </p>
      </div>
    </section>

    <section class="section section-tight" id="tasks">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2>Пять задач,<br>а не пять отраслей</h2>
          </div>
          <p class="aside">
            Клиент приходит с ситуацией, а не с отраслью. Вот пять ситуаций
            из кейсов и то, чем каждая закрыта на сайте.
          </p>
        </div>

        <div class="task-list">
          {tasks.map((item) => (
            <article class="task-row">
              <span class="task-num">{item.num}</span>
              <div class="task-body">
                <h3>{item.task}</h3>
                <p>{item.solution}</p>
              </div>
              <a class="task-link" href={`/cases/${item.slug}/`}>
                {item.label} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-tight" id="cases">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2>Кейсы<br>сайтов</h2>
          </div>
          <p class="aside">
            Каждый проект разобран на отдельной странице: с какой задачей пришел
            клиент, как собиралась структура и что получилось на выходе.
          </p>
        </div>

        <div class="pcase-grid pcase-grid--three">
          {webFeatured.map((item, i) => (
            <a class="pcase" href={`/cases/${item.slug}/`}>
              <span class="pcase__media">
                <img
                  src={item.coverSrc}
                  srcset={coverSrcset(item.coverSrc)}
                  sizes={coverSizes}
                  alt={item.coverAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  width="1600"
                  height="900"
                />
              </span>
              <span class="pcase__body">
                <strong>{item.title}</strong>
                <span class="pcase__meta">{item.meta}</span>
              </span>
              <span class="pcase__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="gallery-more">
          <a class="btn btn-dark btn-lg" href="/portfolio/?direction=web">
            Смотреть все работы по сайтам <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <ReturningClients variant="compact" />

    <ProcessSteps {...process} />

    <FounderSection data={webFounder} />

    <FAQ
      title="Частые<br>вопросы"
      intro="Если короткого ответа недостаточно — напишите в Telegram. Посмотрю текущий сайт и отвечу по вашей задаче."
      ctaAsk="Задать вопрос"
      telegramUrl={site.contact.telegram}
      items={faqItems.map((item) => ({ q: item.q, a: item.aHtml ?? item.a }))}
    />

    <ContactForm
      data={contactData}
      telegramUrl={site.contact.telegram}
      telegramHandle={site.contact.telegramHandle}
      maxUrl={site.contact.max}
      maxHandle={site.contact.maxHandle}
      briefUrl="/tools/brief-website.html"
      briefLabel="Заполнить бриф на сайт"
      goalName="website_lead_submit"
      messageIntro="Здравствуйте! Хочу обсудить разработку сайта."
    />
  </main>

  <Footer {...footer} />

  <script is:inline>
    (function () {
      'use strict';

      /* Цели Метрики. Отправка формы живет в ContactForm.astro. */
      function goal(name, params) {
        if (typeof window.ksAnalyticsGoal === 'function') window.ksAnalyticsGoal(name, params);
      }

      var form = document.getElementById('lead-form');
      var fields = document.getElementById('form-fields');
      var success = document.getElementById('form-success');
      var fMessage = document.getElementById('f-message');

      /* Кнопки форматов: префилл формы + скролл + цель */
      Array.prototype.forEach.call(document.querySelectorAll('[data-package]'), function (btn) {
        btn.addEventListener('click', function () {
          if (success && success.hidden === false) { success.hidden = true; fields.hidden = false; form.classList.remove('is-success'); }
          if (fMessage) fMessage.value = 'Интересует формат: ' + btn.dataset.package + '.';
          goal('website_package_pick', { pkg: btn.dataset.package });
        });
      });

      Array.prototype.forEach.call(document.querySelectorAll('a[href="#contact"]'), function (link) {
        link.addEventListener('click', function () { goal('website_cta_main'); });
      });

      Array.prototype.forEach.call(document.querySelectorAll('a[href^="https://t.me/"]'), function (link) {
        link.addEventListener('click', function () { goal('telegram_direct'); });
      });

      Array.prototype.forEach.call(document.querySelectorAll('a[href^="tel:"]'), function (link) {
        link.addEventListener('click', function () { goal('cta_phone'); });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* В карточках типов сайта нет строки с ценой, поэтому к нижнему краю
     прижимается сама ссылка (как на /packaging/ и /identity/). */
  .scenario-card a {
    margin-top: auto;
  }

  /* Водяной знак hero: слово читает .hero-red::after в global.css. */
  .websites-hero-wrap :global(.hero-red) {
    --hero-watermark: 'WEB';
  }

  /* В блоке «Что делает сайт рабочим» четыре карточки: в базовой сетке
     из трех колонок четвертая повисала одна в ряду, поэтому здесь 2×2. */
  @media (min-width: 801px) {
    .approach-wrap :global(.what-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Границы продукта: две карточки, левая — что беру, правая — что нет.
     Красная линия только у левой: правая не должна читаться как оффер. */
  .boundary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .boundary-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 30px;
    background: var(--bg-2);
    border-top: 3px solid var(--ks-red);
  }

  .boundary-card--skip {
    border-top-color: var(--fg-3);
  }

  .boundary-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ks-red);
  }

  .boundary-card--skip .boundary-kicker {
    color: var(--fg-3);
  }

  .boundary-card h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.25;
  }

  .boundary-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .boundary-card li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.5;
  }

  .boundary-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .6em;
    width: 8px;
    height: 2px;
    background: var(--ks-red);
  }

  .boundary-card--skip li::before {
    background: var(--fg-3);
  }

  .boundary-note {
    margin: 4px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-1);
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-3);
  }

  /* Задачи: строка «номер — задача и решение — ссылка на кейс».
     Список, а не карточки: важен порядок чтения, а не сравнение. */
  .task-list {
    display: grid;
    gap: 2px;
    background: var(--line-1);
    border-top: 1px solid var(--line-1);
    border-bottom: 1px solid var(--line-1);
  }

  .task-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 26px 4px;
    background: var(--bg-1);
  }

  .task-num {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .14em;
    color: var(--ks-red);
    padding-top: 4px;
  }

  .task-body h3 {
    margin: 0 0 6px;
    font-size: 20px;
    line-height: 1.25;
  }

  .task-body p {
    margin: 0;
    color: var(--fg-3);
    font-size: 15px;
    line-height: 1.55;
  }

  .task-link {
    display: inline-flex;
    gap: 6px;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 600;
    padding-top: 4px;
  }

  @media (max-width: 900px) {
    .boundary-grid {
      grid-template-columns: 1fr;
    }

    .task-row {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 8px 16px;
    }

    .task-link {
      grid-column: 2;
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-top: 0;
    }
  }
</style>
