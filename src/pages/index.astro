---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import RevealScript from '../components/RevealScript.astro';
import { directionByCategory } from '../data/case-catalog';
import { editorialCaseConfigs } from '../data/case-page-config';

const dataDir = path.resolve('./src/data');
const site = yaml.load(fs.readFileSync(path.join(dataDir, 'site.yaml'), 'utf8')) as any;
const taxonomy = yaml.load(fs.readFileSync(path.join(dataDir, 'taxonomy.yaml'), 'utf8')) as any;

// Тексты и переходы по направлениям — ключ соответствует taxonomy.yaml.
// Числа в плашках НЕ прописываются руками: они считаются ниже по кейсам,
// иначе после каждой публикации приходится помнить про этот блок.
// `prefix` — то, что стоит перед счетчиком, если у направления есть что сказать
// сверх количества кейсов.
// `status` получает посчитанные количества кейсов и работ и возвращает строку
// плашки. Направление без кейсов до этого не доходит — там всегда «скоро».
const directionContent: Record<
  string,
  { text: string; href: string; status: (cases: number, works: number) => string }
> = {
  packaging: {
    text: 'Дизайн упаковки для розницы и HoReCa. Отдаю макет, готовый к печати.',
    href: '/portfolio/?direction=packaging',
    status: (cases) => `${cases} ${plural(cases, 'кейс', 'кейса', 'кейсов')} в портфолио`,
  },
  identity: {
    text: 'Логотип, палитра, шрифты и правила их применения. По ним дальше собираются упаковка, сайт и презентации.',
    href: '/portfolio/?direction=identity',
    status: (cases) => `${cases} ${plural(cases, 'кейс', 'кейса', 'кейсов')} в портфолио`,
  },
  web: {
    text: 'Сайты и одностраничники для бизнеса: структура, тексты и готовые страницы.',
    href: '/portfolio/?direction=web',
    status: (cases) => `${cases} ${plural(cases, 'кейс', 'кейса', 'кейсов')} в портфолио`,
  },
  presentations: {
    text: 'Структура, текст, слайды и инфографика: питчи, отчеты, маркетинг-киты.',
    href: '/presentations/',
    status: (cases) => `Калькулятор цены · ${cases} ${plural(cases, 'кейс', 'кейса', 'кейсов')}`,
  },
  wrap: {
    text: 'Рекламная, брендовая и имиджевая оклейка коммерческого транспорта. Фургоны, такси, доставка, спецтехника.',
    href: '/car-wrap/',
    status: (cases) => `От 10 000 ₽ · ${cases} ${plural(cases, 'кейс', 'кейса', 'кейсов')} в портфолио`,
  },
};

const pad = (n: number) => String(n).padStart(2, '0');
const plural = (n: number, one: string, few: string, many: string) => {
  const mod100 = n % 100;
  const mod10 = n % 10;
  if (mod100 >= 11 && mod100 <= 14) return many;
  if (mod10 === 1) return one;
  if (mod10 >= 2 && mod10 <= 4) return few;
  return many;
};

// Кейсы по направлениям: те же источники, что и в портфолио, — legacy
// cases.yaml и коллекция из cases/. Направление без кейсов показывается
// как «скоро». Считаем только кейсы: отдельные ракурсы оклейки из
// gallery.yaml — это виды одной и той же работы, а не разные работы.
const legacyCases = yaml.load(fs.readFileSync(path.join(dataDir, 'cases.yaml'), 'utf8')) as any[];
const editorialEntries = (await getCollection('cases', ({ data }) => !data.draft))
  .filter((entry) => Boolean(entry.data.gallery) || Boolean(editorialCaseConfigs[entry.id]));

const directionOfCase: Record<string, string> = {};
for (const c of legacyCases) {
  const key = c.direction ?? directionByCategory[c.category];
  if (key) directionOfCase[c.slug] = key;
}
for (const entry of editorialEntries) {
  const key = directionByCategory[entry.data.category];
  if (key) directionOfCase[entry.data.slug] = key;
}

const countCases = (key: string) =>
  Object.values(directionOfCase).filter((d) => d === key).length;

const directions = taxonomy.directions.map((d: any, i: number) => {
  const content = directionContent[d.key];
  const cases = countCases(d.key);
  return {
    num: pad(i + 1),
    key: d.key,
    label: d.label,
    text: content.text,
    href: content.href,
    soon: cases === 0,
    status: cases === 0 ? 'Работы пока не опубликованы' : content.status(cases),
    ctaLabel: cases === 1 ? 'Смотреть кейс' : 'Смотреть направление',
  };
});

const totalCases = Object.keys(directionOfCase).length;
const proofNums =
  `${totalCases} ${plural(totalCases, 'разобранный кейс', 'разобранных кейса', 'разобранных кейсов')} в портфолио.`;

const publishedCount = directions.filter((d: any) => !d.soon).length;
const numeralDative = ['нулю', 'одному', 'двум', 'трем', 'четырем', 'пяти'];
const directionsLede =
  publishedCount === directions.length
    ? 'По всем направлениям работы опубликованы в портфолио.'
    : `По ${numeralDative[publishedCount] ?? publishedCount} направлени${publishedCount === 1 ? 'ю' : 'ям'} работы уже опубликованы. По остальным примеры пришлю в переписке.`;

const benefits = [
  {
    k: 'С 2010 года',
    v: '120+ проектов: упаковка, фирменный стиль, сайты, презентации, оклейка транспорта.',
  },
  {
    k: 'Смета в день брифа',
    v: 'Бриф занимает 10 минут в переписке. В тот же день отвечаю с ценой и сроком.',
  },
  {
    k: 'Работаю по всей России',
    v: 'Владивосток, но процесс полностью онлайн: Telegram, видеосвязь, файлы почтой. Локация не влияет на цену.',
  },
  {
    k: 'Официально, по договору',
    v: 'ИП, договор, ЭДО и NDA по запросу. Все исходники передаю вам.',
  },
];

const process = {
  title: 'Как я<br>работаю',
  aside: 'Один процесс для любого направления: упаковка, сайт, презентация, оклейка.',
  steps: [
    { num: '01', title: 'Бриф', text: 'Пишете, что нужно и по какому направлению. Обычно это 10 минут в переписке.' },
    { num: '02', title: 'Концепция', text: 'Показываю концепцию и объясняю решение. Где выбор влияет на результат, даю 2–3 варианта подачи.' },
    { num: '03', title: 'Правки', text: 'Правки внутри одобренной концепции включены в цену. Разворот в принципиально новую сторону считаю отдельно.' },
    { num: '04', title: 'Готовый файл', text: 'Отдаю макет в нужном формате: под печать, для сайта или для презентации. Исходники ваши.' },
  ],
};

const faqItems = [
  { q: 'Не знаю, какое направление мне нужно — что делать?', a: 'Опишите задачу в сообщении. Подскажу направление и примерную цену в переписке или на созвоне.' },
  { q: 'Можно заказать сразу два направления, например логотип и упаковку?', a: 'Да. Такие задачи веду вместе — так проще сохранить единый стиль между материалами.' },
  { q: 'Сколько это стоит?', a: 'Цена зависит от объема и сложности задачи, размер компании на нее не влияет. Оклейка — от 10 000 ₽, упаковка — аудит от 15 000 ₽ и проект от 120 000 ₽, по презентациям на их странице есть калькулятор. Айдентику и сайты считаю индивидуально после брифа.' },
  { q: 'Можно заказать только часть работы?', a: 'Да. Для сайта можно отдельно заказать только текст и структуру, без дизайна и верстки. Для айдентики — только гайдлайн, если логотип уже есть.' },
  { q: 'Работаете один или с командой?', a: 'Все пять направлений веду сам: от брифа до готового файла.' },
  { q: 'Как оформляется работа?', a: 'Официально, как ИП, с договором. ЭДО и NDA — по запросу. Все исходники передаю вам.' },
  { q: 'Как быстро посчитаете стоимость?', a: 'Смету отправляю в тот же день, как получаю бриф.' },
];

const contactData = {
  title: 'Опишите задачу — отвечу за пару часов',
  intro: 'Два обязательных поля. Кнопка откроет Telegram с готовым сообщением: останется отправить его в чате.',
  telegramTitle: 'Написать в Telegram',
  maxTitle: 'Написать в MAX',
  formTitle: 'Расскажите о задаче',
  fields: {
    name: { label: 'Имя', placeholder: 'Как к вам обращаться' },
    car: { label: 'Направление и задача', placeholder: 'Например: логотип для фермерского хозяйства' },
    message: { label: 'Детали, если есть (необязательно)', placeholder: 'Бюджет, сроки, что уже готово' },
  },
  privacy: 'Поля не отправляются на сервер сайта. Сообщение уйдет только после отправки в выбранном вами мессенджере.',
  submit: 'Открыть Telegram с готовым сообщением',
  successTitle: 'Сообщение собрано',
  successText: 'Telegram должен открыться в новой вкладке с готовым сообщением. Нажмите в чате «отправить» — отвечу в течение пары часов. Если вкладка не открылась, воспользуйтесь кнопкой ниже.',
  reopen: 'Открыть Telegram еще раз',
  resetText: 'Отправить еще одну заявку',
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site.url}/#collection`,
  name: 'Услуги Kovtun.studio',
  url: `${site.url}/`,
  isPartOf: { '@id': `${site.url}/#business` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: directions.map((d: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: d.label,
      url: new URL(d.href, `${site.url}/`).toString(),
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="Дизайн для бизнеса — упаковка, айдентика, сайты, презентации, оклейка авто · Kovtun.studio"
  description="Упаковка, логотип и фирменный стиль, сайты, презентации и оклейка транспорта. Все пять направлений ведет один дизайнер: бриф, концепция, правки, готовый файл. Смета в день брифа."
  keywords="услуги дизайнера, упаковка, фирменный стиль, дизайн сайта, презентации, оклейка авто, Владивосток, Kovtun.studio"
  canonicalPath="/"
  ogImage="/og-services.jpg"
  ogImageAlt="Работы Kovtun.studio: презентации, брошюра, сайт и оклейка транспорта"
  structuredData={[collectionLd, faqLd]}
  bodyClass="page-services"
>
  <Header
    nav={site.nav}
    phone={site.contact.phone}
    phoneTel={site.contact.phoneTel}
    telegramUrl={site.contact.telegram}
    maxUrl={site.contact.max}
  />

  <main id="main-content">
    <section class="services-hero">
      <div class="container-wide">
        <h1 class="reveal" style="--reveal-delay: 60ms">
          Упаковка, логотип, сайт,<br>
          презентация, оклейка.<br>
          <em class="accent">Один дизайнер, один счет</em>
        </h1>
        <p class="s-lede reveal" style="--reveal-delay: 120ms">
          Беру бриф, показываю концепцию, дорабатываю по вашим замечаниям и отдаю
          готовый файл. Между вами и дизайнером нет менеджера, поэтому правки идут
          напрямую и ничего не теряется в пересказе.
        </p>
        <div class="s-ctas reveal" style="--reveal-delay: 180ms">
          <a class="btn btn-primary btn-lg" href="#contact">
            Получить смету <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-dark btn-lg" href="/portfolio/">
            Смотреть портфолио <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section-tight services-benefits">
      <div class="container-wide">
        <div class="benefits-grid">
          {benefits.map((b, i) => (
            <div class="benefit reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <div class="benefit-k">{b.k}</div>
              <div class="benefit-v">{b.v}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="directions">
      <div class="container-wide">
        <div class="section-head">
          <h2>Пять направлений</h2>
          <p class="aside">{directionsLede}</p>
        </div>
        <div class="dir-grid">
          {directions.map((d: any, i: number) => (
            <a class="dir-card reveal" href={d.href} style={`--reveal-delay: ${i * 50}ms`} data-direction={d.key}>
              <span class="dc-num">{d.num}</span>
              <h3>{d.label}</h3>
              <p>{d.text}</p>
              <span class:list={['dc-status', { 'is-soon': d.soon }]}>{d.status}</span>
              <span class="dc-cta">{d.ctaLabel} <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ProcessSteps {...process} />

    <section class="section-tight services-proof" id="proof">
      <div class="container-wide">
        <div class="proof-row reveal">
          <div class="proof-copy">
            <h2>Клиенты из разных сфер</h2>
            <p class="proof-names">
              <b>«Green Power»</b>, <b>«Металл Инвест»</b>, <b>«Тернейский фермер»</b>,
              <b>ВМТП</b>, <b>«Japan Шина»</b>, <b>Sila Car</b>, <b>«Капиталъ Информ»</b>,
              <b>«Трубоварня Еремеева»</b>, <b>ПТК «Стройконструкция»</b>,
              <b>EON Phuket</b>, <b>«Кузница души»</b>, <b>«Эктострой»</b>,
              <b>Greatway</b>, <b>EVG Group</b>, <b>B2B Cosmetics</b>.
              Производство питания, металлургия, агробизнес, логистика и порт,
              автобизнес, бухгалтерские услуги, инженерные системы, производство
              металлоконструкций, спа и велнес, выездные мужские программы,
              умный дом, недвижимость, оптовая торговля косметикой.
            </p>
            <p class="proof-nums">{proofNums}</p>
          </div>
          <a class="btn btn-dark" href="/portfolio/">
            Смотреть портфолио <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <FAQ
      title="Частые<br>вопросы"
      intro="Не нашли свой вопрос — напишите в Telegram."
      ctaAsk="Задать вопрос"
      telegramUrl={site.contact.telegram}
      items={faqItems}
    />

    <ContactForm
      data={contactData}
      telegramUrl={site.contact.telegram}
      telegramHandle={site.contact.telegramHandle}
      maxUrl={site.contact.max}
      maxHandle={site.contact.maxHandle}
    />
  </main>

  <Footer {...site.footer} />
  <RevealScript />

  <script is:inline define:vars={{
    TELEGRAM_URL: site.contact.telegram,
    MAX_URL: site.contact.max,
    METRIKA_ID: site.metrika.id,
    CONSENT_MARKER: `Согласие на обработку персональных данных: да · редакция ${site.legal.policyVersion} от ${site.legal.policyDate} · ${site.url}/consent/`,
  }}>
    (function () {
      'use strict';

      function goal(name, params) {
        if (typeof window.ym === 'function') {
          try { window.ym(METRIKA_ID, 'reachGoal', name, params || {}); } catch (e) {}
        }
      }

      function buildMessage(data) {
        var lines = ['Здравствуйте! Хочу обсудить проект дизайна.', ''];
        if (data.name) lines.push('Имя: ' + data.name);
        if (data.task) lines.push('Направление и задача: ' + data.task);
        if (data.materials) lines.push('\nДетали:\n' + data.materials);
        if (data.leadId) lines.push('\nЗаявка ID: ' + data.leadId);
        lines.push('\n' + CONSENT_MARKER);
        return lines.join('\n');
      }

      var form = document.getElementById('lead-form');
      var fName = document.getElementById('f-name');
      var fTask = document.getElementById('f-car');
      var fMessage = document.getElementById('f-message');
      var errName = document.getElementById('err-name');
      var errTask = document.getElementById('err-car');
      var fields = document.getElementById('form-fields');
      var success = document.getElementById('form-success');
      var successText = document.getElementById('success-text');
      var reopen = document.getElementById('reopen-messenger');
      var copyBlock = document.getElementById('copy-text-block');
      var copyArea = document.getElementById('copy-text-area');
      var copyBtn = document.getElementById('copy-text-btn');
      var copyBtnLabel = document.getElementById('copy-text-btn-label');

      function setError(node, message) {
        if (!node) return;
        node.textContent = message || '';
        node.hidden = !message;
      }

      function validate() {
        var ok = true;
        if (!fName.value.trim()) { setError(errName, 'Как к вам обращаться?'); ok = false; }
        else setError(errName, '');
        if (!fTask.value.trim()) { setError(errTask, 'Какое направление и задача?'); ok = false; }
        else setError(errTask, '');
        return ok;
      }

      if (form) {
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          if (!validate()) return;

          var target = (event.submitter && event.submitter.dataset.target) || 'telegram';
          var label = target === 'max' ? 'MAX' : 'Telegram';
          var leadId = typeof window.kovtunLeadEvent === 'function'
            ? window.kovtunLeadEvent({ messenger: label })
            : '';
          var text = buildMessage({ name: fName.value.trim(), task: fTask.value.trim(), materials: fMessage.value.trim(), leadId: leadId });
          var url = target === 'max' ? MAX_URL : TELEGRAM_URL + '?text=' + encodeURIComponent(text);

          if (target === 'max') {
            copyArea.value = text;
            copyBlock.hidden = false;
            successText.textContent = 'MAX откроется в новой вкладке. Скопируйте текст заявки кнопкой ниже и вставьте в чат.';
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).catch(function () {});
          } else {
            copyBlock.hidden = true;
            successText.textContent = 'Telegram должен открыться в новой вкладке с готовым сообщением. Нажмите в чате «отправить» — отвечу в течение пары часов. Если вкладка не открылась, воспользуйтесь кнопкой ниже.';
          }

          window.open(url, '_blank', 'noopener,noreferrer');
          reopen.href = url;
          reopen.innerHTML = 'Открыть ' + label + ' еще раз <span class="arrow" aria-hidden="true">→</span>';
          fields.hidden = true;
          success.hidden = false;
          form.classList.add('is-success');
          goal(target === 'max' ? 'services_lead_max' : 'services_lead_submit');
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var done = function () {
            copyBtnLabel.textContent = 'Скопировано ✓';
            setTimeout(function () { copyBtnLabel.textContent = 'Скопировать текст'; }, 2000);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(copyArea.value).then(done).catch(function () { copyArea.select(); document.execCommand('copy'); done(); });
          } else { copyArea.select(); document.execCommand('copy'); done(); }
        });
      }

      var resetBtn = document.getElementById('form-reset');
      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          form.reset();
          setError(errName, '');
          setError(errTask, '');
          success.hidden = true;
          fields.hidden = false;
          form.classList.remove('is-success');
        });
      }

      Array.prototype.forEach.call(document.querySelectorAll('.dir-card'), function (link) {
        link.addEventListener('click', function () {
          goal('services_direction_click', { direction: link.dataset.direction });
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  .services-hero {
    padding: 96px 0 72px;
    border-bottom: 1px solid var(--line-1);
  }
  .services-hero h1 {
    font: 800 clamp(32px, 5vw, 68px)/1.06 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--fg-1);
    margin: 0 0 28px;
    max-width: 32ch;
  }
  .services-hero h1 em { font-style: normal; }
  .s-lede {
    font: 400 clamp(16px, 1.3vw, 19px)/1.55 var(--font-body);
    color: var(--fg-3);
    max-width: 62ch;
    margin: 0 0 40px;
  }
  .s-ctas { display: flex; gap: 14px; flex-wrap: wrap; }

