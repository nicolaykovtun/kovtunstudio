    name: { label: 'Имя', placeholder: 'Как к вам обращаться' },
    car: { label: 'Продукт и объем', placeholder: 'Например: линейка соусов, 5 SKU' },
    message: { label: 'Что есть по материалам (необязательно)', placeholder: 'Текущая упаковка, тексты составов, требования типографии' },
  },
  privacy: 'Поля не отправляются на сервер сайта. Сообщение уйдет только после отправки в выбранном вами мессенджере.',
