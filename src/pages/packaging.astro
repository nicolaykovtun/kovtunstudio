---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WhatGrid from '../components/WhatGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FounderSection from '../components/FounderSection.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { caseOrderIndex, directionByCategory } from '../data/case-catalog';
import '../styles/presentations.css';

const dataDir = path.resolve('./src/data');
const site = yaml.load(fs.readFileSync(path.join(dataDir, 'site.yaml'), 'utf8')) as any;

// Локальная навигация страницы — как у /presentations/ и /car-wrap/.
const nav = [
  { href: '#scenarios', label: 'Сценарии' },
  { href: '#pricing', label: 'Цены' },
  { href: '#cases', label: 'Работы' },
  { href: '#faq', label: 'FAQ' },
];

const hero = {
  headline: 'Упаковка, которая',
  headlineAccent: 'продает на полке',
  lede:
    'Этикетки, коробки, банки и канистры для производств. Система линейки, ' +
    'которая выдерживает рост до десятков SKU, обязательная маркировка ' +
    'по техрегламентам и файлы, готовые к печати.',
  ctaPrimary: 'Обсудить упаковку',
  ctaSecondary: 'Стоимость работ',
  meta: [
    { num: '40', suffix: ' SKU', label: 'Три линейки Green Power в кейсах' },
    { num: '75', label: 'Макетов отрисовано и подготовлено к печати' },
    { num: '48', suffix: ' ч', label: 'Экспресс-аудит текущей упаковки' },
    { num: 'VVO', numAccent: '.', label: 'Владивосток · работаю по РФ' },
