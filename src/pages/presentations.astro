// Кейсы направления «Презентации» — из той же коллекции, что и портфолио,
// в каноническом порядке каталога. Обложка у этих четырех берется из рукописных
// конфигов: gallery.yaml у них пока нет.
const presentationCases = (await getCollection('cases', ({ data }) => !data.draft))
  .filter((entry) => directionByCategory[entry.data.category] === 'presentations')
  .filter((entry) => Boolean(entry.data.gallery) || Boolean(editorialCaseConfigs[entry.id]))
  .sort((a, b) => caseOrderIndex(a.id) - caseOrderIndex(b.id))
  .map((entry) => {
    const c = entry.data;
    const cover = c.gallery
      ? { src: `${c.gallery.assetRoot}/${c.gallery.cover.src}`, alt: c.gallery.cover.alt }
      : editorialCaseConfigs[entry.id].cover;
    return {
      slug: c.slug,
      title: c.shortTitle || c.client,
      meta: [c.segmentLabel, c.year, c.location].filter(Boolean).join(' · '),
      coverSrc: cover.src,
      coverAlt: cover.alt,
    };
  });

// На странице три кейса, как на остальных услугах; в схему — все четыре.
const featuredPresentationSlugs = ['presentation-vmtp', 'presentation-terney-farmer', 'presentation-edelweiss'];
const presentationFeatured = featuredPresentationSlugs
  .map((slug) => presentationCases.find((item) => item.slug === slug))
  .filter((item): item is (typeof presentationCases)[number] => Boolean(item));

const ldPortfolioCases = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${site.url}/presentations/#portfolio`,
  name: 'Кейсы презентаций и брошюр Kovtun.studio',
  url: `${site.url}/presentations/`,
  numberOfItems: presentationCases.length,
  itemListElement: presentationCases.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: item.title,
      url: `${site.url}/cases/${item.slug}/`,
      image: `${site.url}${item.coverSrc}`,
      creator: { '@id': `${site.url}/#business` },
    },
  })),
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/presentations/#service`,
  name: 'Разработка презентаций под ключ',
  serviceType: 'Дизайн и разработка презентаций',
  description: 'Структура, текст, дизайн и инфографика для презентаций инвесторам, клиентам и сотрудникам.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'Country', name: 'Россия' },
  offers: packages.map((item) => ({
    '@type': 'Offer',
    name: `${item.title}, 10 слайдов`,
