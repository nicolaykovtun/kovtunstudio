---
// Список статей блога. Редакционная лента на всю ширину сайта:
// обложка · крупная дата · заголовок с рубрикой · описание.
// Схема — CollectionPage со списком BlogPosting.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import site from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Статьи о дизайне для бизнеса · Kovtun.studio';
const description =
  'Практика студии: оклейка и брендирование авто, фирменный стиль, сайты и презентации. ' +
  'Реальные цены, сроки и разборы проектов от Николая Ковтуна.';

const pad = (n: number) => String(n).padStart(2, '0');
const dayMonth = (d: Date) => `${pad(d.getDate())}.${pad(d.getMonth() + 1)}`;
const yearShort = (d: Date) => String(d.getFullYear()).slice(2);
const isoDate = (d: Date) => d.toISOString().split('T')[0];

const ldCollection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Статьи Kovtun.studio',
  description,
  url: `${site.url}/blog/`,
  inLanguage: 'ru',
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `${site.url}/blog/${post.id}/`,
    datePublished: isoDate(post.data.pubDate),
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/blog/"
  ogTitle={title}
  ogDescription={description}
  structuredData={[ldCollection]}
>
  <Header
    nav={site.nav}
    phone={site.contact.phone}
    phoneTel={site.contact.phoneTel}
    telegramUrl={site.contact.telegram}
    maxUrl={site.contact.max}
  />

  <main id="main-content" class="blog-page">
    <div class="container-wide">
      <header class="blog-hero">
        <div>
          <p class="blog-eyebrow">Мысли</p>
          <h1>Практика дизайна для бизнеса</h1>
        </div>
        <p class="blog-intro">
          Разборы реальных проектов студии: цены, сроки, ошибки и выводы.
          Без теории ради теории — только то, что проверено работой.
        </p>
      </header>

      <div class="blog-list">
        {posts.map((post) => (
          <article class="blog-row">
            <a href={`/blog/${post.id}/`} class="blog-row-cover" aria-hidden="true" tabindex="-1">
              {post.data.cover && (
                <img src={post.data.cover} alt="" loading="lazy" />
              )}
            </a>
            <p class="blog-row-date">
              <time datetime={isoDate(post.data.pubDate)}>
                <span class="blog-row-daymonth">{dayMonth(post.data.pubDate)}</span>
                <span class="blog-row-year">{yearShort(post.data.pubDate)}</span>
              </time>
            </p>
            <div class="blog-row-main">
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <span class="blog-row-tag">{post.data.section}</span>
            </div>
            <div class="blog-row-side">
              <p class="blog-row-desc">{post.data.description}</p>
              <a class="blog-row-more" href={`/blog/${post.id}/`}>Читать статью</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer {...site.footer} />
</BaseLayout>

<style>
  .blog-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
    padding-block: clamp(32px, 6vw, 80px) clamp(20px, 3vw, 36px);
  }
  .blog-eyebrow {
    font: var(--t-overline);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ks-grey);
    margin: 0 0 12px;
  }
  .blog-hero h1 {
    margin: 0;
    font-size: clamp(30px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .blog-intro {
    font: var(--t-body-l);
    line-height: 1.6;
    color: var(--ks-charcoal);
    margin: 0;
    max-width: 46ch;
    justify-self: end;
  }

  .blog-list { border-bottom: 1px solid var(--line-strong); }
  .blog-row {
    display: grid;
    grid-template-columns: 240px 140px minmax(0, 1.3fr) minmax(0, 1fr);
    border-top: 1px solid var(--line-strong);
    padding-block: 28px;
  }
  .blog-row-cover {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ks-paper);
    margin-right: 28px;
  }
  .blog-row-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s var(--ease-out);
  }
  .blog-row:hover .blog-row-cover img { transform: scale(1.03); }

  .blog-row-date { margin: 0; padding-inline: 4px 20px; }
  .blog-row-date time { display: flex; flex-direction: column; line-height: 1.1; }
  .blog-row-daymonth { font-size: clamp(22px, 2.2vw, 30px); font-weight: 700; }
  .blog-row-year { font-size: clamp(18px, 1.8vw, 24px); font-weight: 700; color: var(--ks-grey); }

  .blog-row-main {
    border-left: 1px solid var(--line-strong);
    padding-inline: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .blog-row-main h2 {
    margin: 0;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.25;
  }
  .blog-row-main h2 a { color: inherit; text-decoration: none; }
  .blog-row-main h2 a:hover { color: var(--ks-red); }
  .blog-row-tag {
    font: var(--t-caption);
    color: var(--ks-grey);
    border: 1px solid var(--line-strong);
    padding: 3px 10px;
  }

  .blog-row-side {
    padding-left: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .blog-row-desc {
    margin: 0;
    font: var(--t-body-s);
    line-height: 1.55;
    max-width: 52ch;
  }
  .blog-row-more { font-weight: 600; }

  @media (max-width: 1000px) {
    .blog-hero { grid-template-columns: 1fr; align-items: start; }
    .blog-intro { justify-self: start; }
    .blog-row { grid-template-columns: 180px 90px minmax(0, 1fr); }
    .blog-row-cover { margin-right: 20px; }
    .blog-row-main { padding-inline: 20px; border-left: none; }
    .blog-row-side {
      grid-column: 2 / -1;
      padding-left: 20px;
      padding-top: 14px;
    }
  }
  @media (max-width: 640px) {
    .blog-row { grid-template-columns: 1fr; gap: 14px; }
    .blog-row-cover { margin-right: 0; }
    .blog-row-date { padding-inline: 0; }
    .blog-row-date time { flex-direction: row; gap: 6px; }
    .blog-row-main { padding-inline: 0; }
    .blog-row-side { grid-column: auto; padding: 0; }
  }
</style>
