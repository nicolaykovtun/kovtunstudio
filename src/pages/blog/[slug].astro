---
// Страница статьи блога. Контент — из коллекции blog (src/content/blog/*.md).
// Верстка: две колонки — статья и сайдбар (карточка автора + липкое оглавление).
// JSON-LD: BlogPosting + FAQPage (из шапки статьи) + BreadcrumbList.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import site from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;

// Оглавление — только заголовки второго уровня.
const toc = headings.filter((h) => h.depth === 2);

// Похожие статьи: сначала то же направление, добираем свежими, максимум 3.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).filter(
  (p) => p.id !== post.id
);
const sameSection = allPosts.filter((p) => p.data.section === d.section);
const others = allPosts.filter((p) => p.data.section !== d.section);
const related = [...sameSection, ...others]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const canonicalPath = `/blog/${post.id}/`;
const pageUrl = new URL(canonicalPath, `${site.url}/`).toString();
const pageTitle = `${d.seoTitle ?? d.title} · Kovtun.studio`;

const dateFmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const published = dateFmt.format(d.pubDate);
const isoDate = (value: Date) => value.toISOString().split('T')[0];

const coverUrl = d.cover ? new URL(d.cover, `${site.url}/`).toString() : null;

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  inLanguage: 'ru',
  datePublished: isoDate(d.pubDate),
  dateModified: isoDate(d.updatedDate ?? d.pubDate),
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  articleSection: d.section,
  ...(coverUrl ? { image: coverUrl } : {}),
  author: {
    '@type': 'Person',
    name: site.author.name,
    jobTitle: site.author.jobTitle,
    url: `${site.url}/`,
    sameAs: [site.contact.telegram],
  },
  publisher: { '@id': `${site.url}/#business` },
};

const ldFaq = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

const ldBreadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Мысли', item: `${site.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
  ],
};

const structuredData = [ldArticle, ...(ldFaq ? [ldFaq] : []), ldBreadcrumbs];

const tgChannel = 'https://t.me/kovtundesign';
---

<BaseLayout
  title={pageTitle}
  description={d.description}
  canonicalPath={canonicalPath}
  ogTitle={pageTitle}
  ogDescription={d.description}
  ogType="article"
  ogImage={d.cover ?? undefined}
  ogImageAlt={d.coverAlt ?? d.title}
  structuredData={structuredData}
>
  <Header
    nav={site.nav}
    phone={site.contact.phone}
    phoneTel={site.contact.phoneTel}
    telegramUrl={site.contact.telegram}
    maxUrl={site.contact.max}
  />

  <main id="main-content" class="post-page">
    <div class="container-wide">
      <nav class="post-breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">Мысли</a>
      </nav>

      <div class="post-layout">
        <div class="post-main">
          <header class="post-hero">
            <p class="post-eyebrow">{d.section}</p>
            <h1>{d.title}</h1>
            <p class="post-meta">
              <span>{site.author.name}, {site.author.jobTitle.toLowerCase()}</span>
              <time datetime={isoDate(d.pubDate)}>{published}</time>
            </p>
          </header>

          {d.cover && (
            <figure class="post-cover">
              <img src={d.cover} alt={d.coverAlt ?? d.title} width="1200" loading="eager" />
            </figure>
          )}

          <article class="post-content">
            <Content />
          </article>

          <aside class="post-cta">
            <h2>Делаю первое звено цепочки</h2>
            <p>
              Дизайн — моя часть работы: макеты под печать, которые производство
              берет без доработок. Работаю удаленно по всей России, по запросу
              подскажу проверенных печатников и оклейщиков во Владивостоке.
            </p>
            <p class="post-cta-links">
              <a class="btn btn-primary" href={d.serviceLink}>{d.serviceLabel}</a>
              {d.caseLink && <a class="post-cta-case" href={d.caseLink}>{d.caseLabel}</a>}
            </p>
          </aside>

          <aside class="post-subscribe">
            <img class="post-subscribe-avatar" src="/assets/nikolai.webp" alt={site.founderSection.imageAlt} width="72" height="72" loading="lazy" />
            <div class="post-subscribe-body">
              <p class="post-subscribe-name">{site.author.name}</p>
              <p class="post-subscribe-text">
                В телеграм-канале разбираю работы студии, показываю кухню проектов
                и делюсь опытом работы с ИИ в дизайне. Коротко и без воды.
              </p>
              <a class="btn btn-dark" href={tgChannel} target="_blank" rel="noopener">
                Подписаться на канал <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </aside>
        </div>

        <aside class="post-side">
          <div class="post-side-sticky">
            <div class="post-author">
              <div class="post-author-head">
                <img src="/assets/nikolai.webp" alt={site.founderSection.imageAlt} width="56" height="56" loading="lazy" />
                <div>
                  <p class="post-author-name">{site.author.name}</p>
                  <p class="post-author-role">Автор статьи</p>
                </div>
              </div>
              <p class="post-author-text">
                Графический дизайнер. Kovtun.studio — я сам, без команды и менеджеров:
                веду проект от брифа до готового файла. Упаковка, фирменный стиль,
                сайты, презентации и оклейка авто. В дизайне с 2010 года.
                Пишу о работе в <a href={tgChannel} target="_blank" rel="noopener">телеграм-канале</a>.
              </p>
            </div>

            {toc.length > 1 && (
              <nav class="post-toc" aria-label="Оглавление статьи">
                <p class="post-toc-title">Оглавление</p>
                <ul>
                  {toc.map((h) => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ul>
              </nav>
            )}
          </div>
        </aside>
      </div>
    </div>

    {d.faq.length > 0 && (
      <FAQ {...site.faqSection} telegramUrl={site.contact.telegram} items={d.faq} />
    )}

    {related.length > 0 && (
      <section class="section post-related">
        <div class="container-wide">
          <div class="post-related-head">
            <h2>Похожие статьи</h2>
            <a href="/blog/">Все статьи →</a>
          </div>
          <div class="post-related-grid">
            {related.map((p) => (
              <article class="post-related-card">
                <a href={`/blog/${p.id}/`} class="post-related-cover">
                  {p.data.cover
                    ? <img src={p.data.cover} alt={p.data.coverAlt ?? p.data.title} loading="lazy" />
                    : <span class="post-related-placeholder" aria-hidden="true">K</span>}
                </a>
                <p class="post-related-meta">
                  <span>{p.data.section}</span>
                  <time datetime={isoDate(p.data.pubDate)}>{dateFmt.format(p.data.pubDate)}</time>
                </p>
                <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
                <p class="post-related-desc">{p.data.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer {...site.footer} />
</BaseLayout>

<script is:inline>
  // Блок подписки на канал встает в середину статьи — перед средним H2.
  (() => {
    const block = document.querySelector('.post-subscribe');
    const content = document.querySelector('.post-content');
    if (!block || !content) return;
    const heads = content.querySelectorAll('h2');
    if (heads.length < 3) return;
    const middle = heads[Math.floor(heads.length / 2)];
    middle.parentNode.insertBefore(block, middle);
  })();

  // Подсветка текущего раздела в оглавлении.
  (() => {
    const links = Array.from(document.querySelectorAll('.post-toc a'));
    if (!links.length || !('IntersectionObserver' in window)) return;
    const map = new Map();
    links.forEach((link) => {
      const id = decodeURIComponent(link.getAttribute('href').slice(1));
      const target = document.getElementById(id);
      if (target) map.set(target, link);
    });
    let active = null;
    const setActive = (link) => {
      if (active === link) return;
      if (active) active.classList.remove('is-active');
      link.classList.add('is-active');
      active = link;
    };
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((e) => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible.length) setActive(map.get(visible[0].target));
    }, { rootMargin: '-10% 0px -70% 0px' });
    map.forEach((_, target) => observer.observe(target));
  })();
</script>

<style>
  .post-breadcrumbs {
    display: flex;
    gap: 10px;
    font: var(--t-caption);
    color: var(--ks-grey);
    padding-top: clamp(24px, 4vw, 48px);
    margin-bottom: 28px;
  }
  .post-breadcrumbs a { color: inherit; }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .post-main { max-width: 760px; }

  .post-eyebrow {
    font: var(--t-overline);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ks-grey);
    margin: 0 0 12px;
  }
  .post-hero h1 {
    margin: 0 0 16px;
    font-size: clamp(28px, 4.5vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font: var(--t-body-s);
    color: var(--ks-grey);
    margin: 0 0 32px;
  }

  .post-cover { margin: 0 0 36px; }
  .post-cover img { display: block; width: 100%; height: auto; }

  .post-content :global(h2) {
    margin: 44px 0 14px;
    font-size: clamp(21px, 2.6vw, 27px);
    line-height: 1.25;
    scroll-margin-top: 90px;
  }
  .post-content :global(p),
  .post-content :global(li) {
    font: var(--t-body-l);
    line-height: 1.65;
  }
  .post-content :global(p) { margin: 0 0 16px; }
  .post-content :global(ul),
  .post-content :global(ol) { padding-left: 22px; margin: 0 0 16px; }
  .post-content :global(li) { margin-bottom: 8px; }
  /* Только контентные картинки маркдауна (p > img), не аватар блока подписки. */
  .post-content :global(p > img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 28px 0 10px;
  }
  .post-content :global(img + em),
  .post-content :global(p:has(> img) + p > em) {
    font: var(--t-caption);
    color: var(--ks-grey);
    font-style: normal;
  }
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0 24px;
    font: var(--t-body-s);
  }
  .post-content :global(th),
  .post-content :global(td) {
    border-bottom: 1px solid var(--line-strong);
    padding: 10px 12px 10px 0;
    text-align: left;
    vertical-align: top;
  }
  .post-content :global(th) { font-weight: 600; }

  .post-cta {
    margin-top: 48px;
    padding: 28px;
    background: var(--ks-paper);
  }
  .post-cta h2 { margin: 0 0 10px; font-size: clamp(19px, 2.2vw, 24px); }
  .post-cta p { margin: 0 0 16px; font: var(--t-body); line-height: 1.6; }
  .post-cta-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .post-cta-case { font-weight: 600; }

  .post-subscribe,
  .post-content :global(.post-subscribe) {
    margin: 36px 0;
    padding: 28px;
    border: 1px solid var(--line-strong);
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .post-subscribe-avatar {
    border-radius: 50%;
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    object-fit: cover;
  }
  .post-subscribe-name { margin: 0 0 8px; font-weight: 700; font-size: 18px; }
  .post-subscribe-text { margin: 0 0 16px; font: var(--t-body); line-height: 1.6; }

  .post-side { min-width: 0; }
  .post-side-sticky {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-height: calc(100vh - 48px);
  }
  .post-author {
    border: 1px solid var(--line-strong);
    padding: 20px;
  }
  .post-author-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .post-author-head img {
    border-radius: 50%;
    width: 56px;
    height: 56px;
    object-fit: cover;
  }
  .post-author-name { margin: 0; font-weight: 700; }
  .post-author-role { margin: 2px 0 0; font: var(--t-caption); color: var(--ks-grey); }
  .post-author-text { margin: 0; font: var(--t-body-s); line-height: 1.55; }

  .post-toc {
    border-left: 2px solid var(--line-strong);
    padding-left: 16px;
    overflow-y: auto;
  }
  .post-toc-title {
    margin: 0 0 10px;
    font: var(--t-overline);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ks-grey);
  }
  .post-toc ul { list-style: none; margin: 0; padding: 0; }
  .post-toc li { margin: 0 0 10px; }
  .post-toc a {
    display: block;
    font: var(--t-body-s);
    line-height: 1.4;
    color: var(--ks-grey);
    text-decoration: none;
  }
  .post-toc a:hover { color: var(--ks-black); }
  .post-toc a.is-active { color: var(--ks-black); font-weight: 600; }

  .post-related { padding-bottom: clamp(48px, 7vw, 96px); }
  .post-related-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  .post-related-head h2 { margin: 0; font-size: clamp(24px, 3vw, 34px); }
  .post-related-head a { font-weight: 600; white-space: nowrap; }
  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .post-related-cover {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--ks-paper);
    overflow: hidden;
    margin-bottom: 14px;
  }
  .post-related-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post-related-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 64px;
    font-weight: 800;
    color: var(--line-strong);
  }
  .post-related-meta {
    display: flex;
    gap: 12px;
    font: var(--t-caption);
    color: var(--ks-grey);
    margin: 0 0 8px;
  }
  .post-related-card h3 {
    margin: 0 0 8px;
    font-size: 19px;
    line-height: 1.3;
  }
  .post-related-card h3 a { color: inherit; text-decoration: none; }
  .post-related-card h3 a:hover { color: var(--fg-accent); }
  .post-related-desc { margin: 0; font: var(--t-body-s); line-height: 1.55; }

  @media (max-width: 1000px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-side { order: 2; }
    .post-side-sticky { position: static; max-height: none; }
    .post-toc { display: none; }
    .post-related-grid { grid-template-columns: 1fr; }
  }
</style>
