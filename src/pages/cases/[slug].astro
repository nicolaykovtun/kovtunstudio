---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import {
  editorialCaseConfigs,
  type CaseGalleryGroup,
  type CaseMedia,
  type CaseStory,
  type EditorialCaseConfig,
} from '../../data/case-page-config';
import { caseOrderIndex, directionByCategory, servicePageByDirection } from '../../data/case-catalog';

export async function getStaticPaths() {
  const legacyCases = yaml.load(
    fs.readFileSync(path.resolve('./src/data/cases.yaml'), 'utf8'),
  ) as any[];
  const entries = await getCollection('cases', ({ data }) => !data.draft);
  const editorialEntries = entries
    .filter((entry) => Boolean(entry.data.gallery) || Boolean(editorialCaseConfigs[entry.id]))
    .sort((a, b) => caseOrderIndex(a.id) - caseOrderIndex(b.id));

  const records = [
    ...legacyCases.map((data) => ({
      slug: data.slug,
      title: data.name,
      kind: 'legacy',
      data,
    })),
    ...editorialEntries.map((entry) => ({
      slug: entry.id,
      title: entry.data.shortTitle || entry.data.title,
      kind: 'editorial',
      data: entry.data,
    })),
  ].sort((a, b) => caseOrderIndex(a.slug) - caseOrderIndex(b.slug));

  return records.map((record, index) => ({
    params: { slug: record.slug },
    props: {
      kind: record.kind,
      rawCase: record.data,
      nextCase: records[(index + 1) % records.length],
    },
  }));
}

const { kind, rawCase, nextCase } = Astro.props as {
  kind: 'legacy' | 'editorial';
  rawCase: any;
  nextCase: { slug: string; title: string };
};

const dataDir = path.resolve('./src/data');
const site = yaml.load(fs.readFileSync(path.join(dataDir, 'site.yaml'), 'utf8')) as any;
const taxonomy = yaml.load(fs.readFileSync(path.join(dataDir, 'taxonomy.yaml'), 'utf8')) as any;

const pad = (value: number) => String(value).padStart(2, '0');

function configFromGallery(c: any): EditorialCaseConfig {
  const gallery = c.gallery;
  const root = gallery.assetRoot;
  const full = (file: string) => `${root}/full/${file}.webp`;
  const thumb = (file: string) => `${root}/thumb/${file}-thumbnail.webp`;

  const groups: CaseGalleryGroup[] = gallery.groups.map((group: any) => ({
    id: group.id,
    label: 'МАКЕТЫ',
    title: group.title,
    intro: group.intro,
    layout: group.layout ?? (group.items.some((item: any) => item.tall) ? 'tall' : 'screens'),
    ratio: group.ratio,
    // Тему берем из gallery.yaml; без нее остается прежняя темная плашка.
    theme: group.theme ?? 'dark',
    interactive: true,
    items: group.items.map((item: any) => ({
      src: full(item.file),
      thumb: thumb(item.file),
      label: item.label,
    })),
  }));

  const story: CaseStory | undefined = gallery.compare
    ? {
        id: 'before-after',
        label: 'ДО — ПОСЛЕ',
        title: gallery.compare.title,
        intro: gallery.compare.intro,
        items: gallery.compare.items.map((item: any) => ({
          number: item.number,
          title: item.title,
          text: item.text,
          media: [
            {
              src: full(item.before),
              alt: item.beforeAlt,
              caption: item.beforeCaption || 'Вайрфрейм / до',
            },
            {
              src: full(item.after),
              alt: item.afterAlt,
              caption: item.afterCaption || 'Дизайн / после',
            },
          ],
        })),
      }
    : undefined;

  return {
    cover: {
      src: `${root}/${gallery.cover.src}`,
      alt: gallery.cover.alt,
    },
    story,
    resultTitle: gallery.resultTitle,
    resultIntro: gallery.resultIntro,
    groups,
    related: gallery.related,
    order: [
      'task',
      ...(story ? [story.id] : []),
      'result',
      ...groups.map((group) => group.id),
      'works',
      ...(gallery.related ? ['related'] : []),
    ],
    cta: gallery.ctaTitle
      ? {
          title: gallery.ctaTitle,
          text: gallery.ctaText,
          button: gallery.ctaButton,
        }
      : undefined,
    keywords: gallery.keywords,
  };
}

function legacyPage(raw: any): { content: any; config: EditorialCaseConfig } {
  const directionLabel =
    taxonomy.directions.find((direction: any) => direction.key === raw.direction)?.label ??
    raw.category;
  const items: CaseMedia[] = raw.images.map((image: any) => ({
    src: `/assets/portfolio/full/${image.id}.webp`,
    thumb: `/assets/portfolio/thumb/${image.id}.webp`,
    label: image.caption,
  }));
  // Макеты под печать лежат отдельно от ракурсов: у каждого кейса своя папка
  // в /assets/cases/<slug>/, нарезка — tmp/slices/wrap-<slug>.json.
  // thumb не задаем намеренно: макет показывается во всю ширину секции,
  // и миниатюра на 640px растянулась бы вдвое.
  const printLayouts: CaseMedia[] = (raw.layouts ?? []).map((layout: any) => ({
    src: `/assets/cases/${raw.slug}/full/${layout.file}.webp`,
    label: layout.caption,
  }));

  return {
    content: {
      slug: raw.slug,
      title: raw.title,
      shortTitle: raw.name,
      summary: raw.intro,
      seoDescription: raw.seoDescription,
      categoryLabel: raw.category,
      client: raw.name,
      accent: raw.accent,
      facts: [
        { value: raw.name, label: 'клиент' },
        { value: directionLabel, label: 'направление' },
        { value: raw.vehicles, label: 'носитель' },
      ].filter((fact) => fact.value),
      task: [raw.task, raw.solution].filter(Boolean),
      solutions: raw.moves,
      result: [raw.result],
      deliverables: [
        raw.category,
        `Адаптация под ${raw.vehicles}`,
        'Макет под печать',
      ].filter(Boolean),
      credits: [{ role: 'Дизайн', name: 'Николай Ковтун' }],
      links: [],
    },
    config: {
      cover: {
        src: `/assets/portfolio/full/${raw.cover}.webp`,
        alt: raw.images.find((image: any) => image.id === raw.cover)?.caption ?? raw.title,
      },
      taskTitle: 'Одна система для реального кузова',
      resultTitle: 'Что получилось',
      groups: [
        {
          id: 'gallery',
          label: 'РАКУРСЫ',
          title: 'Оклейка крупным планом',
          intro: 'Ракурсы, детали и раскладка графики на кузове.',
          layout: 'default',
          theme: 'dark',
          interactive: true,
          items,
        },
        // Макеты под печать: раскладка проекций, по которой печатают пленку.
        // Секция появляется, только если у кейса заполнено поле layouts.
        ...(printLayouts.length
          ? [
              {
                id: 'print',
                label: 'МАКЕТЫ',
                title:
                  printLayouts.length > 1 ? 'Макеты под печать' : 'Макет под печать',
                intro:
                  'Раскладка проекций кузова — то, что уходит в печать пленки.' +
                  ' Нажмите, чтобы рассмотреть детали.',
                layout: 'sheet' as const,
                theme: 'dark' as const,
                interactive: true,
                items: printLayouts,
              },
            ]
          : []),
      ],
      order: ['task', 'result', 'gallery', ...(printLayouts.length ? ['print'] : []), 'works'],
      cta: {
        title: 'Нужен дизайн оклейки?',
        text: 'Пришлите фотографии и модель автомобиля — предложу формат работы и состав макета.',
        button: 'Обсудить оклейку',
      },
      keywords: `${raw.name}, ${raw.category}, дизайн оклейки автомобиля, Николай Ковтун`,
    },
  };
}

const normalized =
  kind === 'legacy'
    ? legacyPage(rawCase)
    : {
        content: rawCase,
        config: rawCase.gallery
          ? configFromGallery(rawCase)
          : editorialCaseConfigs[rawCase.slug],
      };

const c = normalized.content;
const baseConfig = normalized.config;

// Страница услуги этого кейса — для крошек, схемы и CTA.
const directionKey =
  kind === 'legacy'
    ? rawCase.direction ?? directionByCategory[rawCase.category]
    : directionByCategory[rawCase.category];
const service = servicePageByDirection[directionKey];
if (!service) {
  throw new Error(`Кейс ${c.slug}: направление «${directionKey}» не привязано к странице услуги`);
}
if (!baseConfig) {
  throw new Error(`Кейс ${c.slug}: нет конфигурации единого шаблона`);
}

let lightboxIndex = 0;
const groups = baseConfig.groups.map((group) => ({
  ...group,
  items: group.items.map((item) => ({
    ...item,
    lightboxIndex: group.interactive === false ? null : lightboxIndex++,
  })),
}));
// Вводка к блоку «Результат» берется только из конфигурации кейса. Раньше
// здесь стоял запасной вариант на внутренние заметки из case.md, и служебная
// сверка фактов попадала на страницу.
const config = {
  ...baseConfig,
  groups,
};
const lightboxItems = groups
  .filter((group) => group.interactive !== false)
  .flatMap((group) => group.items)
  .map((item) => ({ src: item.src, thumb: item.thumb, label: item.label }));

// Соседние кейсы того же клиента: в gallery.yaml лежит только slug, заголовок
// и обложку берем из источника данных, чтобы они не расходились с кейсом.
// Пять старых кейсов оклейки живут не в content collection, а в cases.yaml,
// поэтому индекс объединяет оба источника.
const relatedPool = await getCollection('cases', ({ data }) => !data.draft);
const relatedLegacyPool = yaml.load(
  fs.readFileSync(path.join(dataDir, 'cases.yaml'), 'utf8'),
) as any[];
const relatedIndex = new Map<
  string,
  { title: string; cover?: string; coverAlt?: string }
>();

for (const entry of relatedPool) {
  const target = entry.data;
  const gallery = target.gallery as any;
  relatedIndex.set(entry.id, {
    title: target.shortTitle || target.title,
    cover: gallery ? `${gallery.assetRoot}/${gallery.cover.src}` : undefined,
    coverAlt: gallery?.cover.alt ?? target.shortTitle,
  });
}

for (const target of relatedLegacyPool) {
  relatedIndex.set(target.slug, {
    title: target.name || target.title,
    cover: `/assets/portfolio/thumb/${target.cover}.webp`,
    coverAlt:
      target.images.find((image: any) => image.id === target.cover)?.caption ??
      target.title,
  });
}

const relatedCases = (config.related?.items ?? [])
  .map((item) => {
    const target = relatedIndex.get(item.slug);
    if (!target) {
      throw new Error(`Кейс ${c.slug}: в related указан неизвестный slug «${item.slug}»`);
    }
    return {
      href: `/cases/${item.slug}/`,
      label: item.label,
      text: item.text,
      title: target.title,
      cover: target.cover,
      coverAlt: target.coverAlt,
    };
  });

const sectionRecords = config.order.map((id, index) => ({
  id,
  number: pad(index + 1),
  story: config.story?.id === id ? config.story : undefined,
  group: groups.find((group) => group.id === id),
}));

// Галереи носят общую подпись «МАКЕТЫ»: у кейса с двумя группами в меню
// выходили два одинаковых пункта. Оставляем первый по каждой подписи.
const navSections = sectionRecords
  .filter((section) => section.id !== 'works' && section.id !== 'result')
  .map((section) => ({
    href: `#${section.id}`,
    label:
      section.id === 'task'
        ? 'Задача'
        : section.id === 'related'
          ? 'ЭТОТ ЖЕ КЛИЕНТ'
          : section.story?.label ?? section.group?.label ?? section.id,
  }));
const nav = [
  { href: '/portfolio/', label: 'Портфолио' },
  ...navSections
    .filter((item, index) => navSections.findIndex((other) => other.label === item.label) === index)
    .slice(0, 3),
];

const footer = {
  ...site.footer,
  columns: [
    {
      title: 'Кейс',
      links: sectionRecords.slice(0, 5).map((section) => ({
        href: `#${section.id}`,
        label:
          section.id === 'task'
            ? 'Задача и решения'
            : section.id === 'result'
              ? 'Результат'
              : section.id === 'works'
                ? 'Состав работ'
                : section.id === 'related'
                  ? 'Этот же клиент'
                  : section.story?.title ?? section.group?.title ?? section.id,
      })),
    },
    site.footer.columns[1],
    {
      title: 'Прочее',
      links: [
        { href: '/', label: 'Главная' },
        { href: '/portfolio/', label: 'Портфолио' },
        { href: '/packaging/', label: 'Упаковка' },
        { href: '/identity/', label: 'Фирменный стиль' },
        { href: '/websites/', label: 'Сайты' },
        { href: '/presentations/', label: 'Презентации' },
        { href: '/car-wrap/', label: 'Оклейка авто' },
        { href: '/blog/', label: 'Мысли' },
      ],
    },
  ],
};

const casePath = `/cases/${c.slug}/`;
const clientLink = c.links?.find((link: any) => /^Сайт клиента$/i.test(link.label));
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: c.title,
    description: c.seoDescription,
    url: `${site.url}${casePath}`,
    ...(c.year ? { dateCreated: c.year } : {}),
    inLanguage: 'ru-RU',
    image: lightboxItems.map((item) => `${site.url}${item.src}`),
    creator: { '@type': 'Person', name: 'Николай Ковтун', url: site.url },
    genre: c.categoryLabel,
    isPartOf: { '@type': 'WebPage', '@id': `${site.url}${service.href}`, name: service.label },
    about: {
      '@type': 'Organization',
      name: c.client,
      ...(clientLink && /^https?:\/\//.test(clientLink.value)
        ? { url: clientLink.value }
        : {}),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Портфолио', item: `${site.url}/portfolio/` },
      { '@type': 'ListItem', position: 3, name: service.label, item: `${site.url}${service.href}` },
      { '@type': 'ListItem', position: 4, name: c.shortTitle, item: `${site.url}${casePath}` },
    ],
  },
];

// Короткий title для выдачи: заголовок-тезис остается в H1, в title идет
// название кейса. Описание режем до размера сниппета по границе предложения.
const seoTitle = `Кейс: ${c.shortTitle} · Kovtun.studio`;
const trimDescription = (text: string, max = 158) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const sentenceEnd = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
  if (sentenceEnd >= 100) return cut.slice(0, sentenceEnd + 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:]$/, '') + '…';
};
const seoDescription = trimDescription(c.seoDescription);

const cta = config.cta ?? {
  title: 'Нужен такой же проект?',
  text: 'Расскажите о задаче — отвечу, сколько это займет и как лучше собрать материал.',
  button: 'Обсудить проект',
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={config.keywords ?? `${c.categoryLabel}, ${c.client}, дизайн, Николай Ковтун`}
  canonicalPath={casePath}
  ogTitle={c.title}
  ogDescription={seoDescription}
  ogImage={config.cover.src}
  ogImageAlt={config.cover.alt}
  ogType="article"
  structuredData={structuredData}
  bodyClass={`case-page${config.bodyVariant ? ` ${config.bodyVariant}` : ''}`}
>
  <div class="page-shell" style={`--case-accent: ${c.accent}`}>
    <Header
      nav={nav}
      phone={site.contact.phone}
      phoneTel={site.contact.phoneTel}
      telegramUrl={site.contact.telegram}
      maxUrl={site.contact.max}
    />

    <main id="main-content">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <div class="container-wide">
          <ol>
            <li><a href="/">Главная</a></li>
            <li><a href="/portfolio/">Портфолио</a></li>
            <li><a href={service.href}>{service.label}</a></li>
            <li aria-current="page">{c.shortTitle}</li>
          </ol>
        </div>
      </nav>

      <section class="case-hero">
        <div class="container-wide">
          <p class="page-kicker">Кейс · {c.categoryLabel.toLowerCase()}</p>
          <div class="case-hero__top">
            <h1>{c.title}</h1>
            <p class="case-hero__summary">{c.summary}</p>
          </div>
          <div class="case-facts" aria-label="Ключевые факты проекта">
            {c.facts.map((fact: any) => (
              <div class="case-fact">
                <strong>{fact.value}</strong>
                <span>{fact.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <figure class="case-cover">
        <img
          src={config.cover.src}
          alt={config.cover.alt}
          width="1800"
          height="1200"
          fetchpriority="high"
        />
      </figure>

      {sectionRecords.map((section) => (
        <>
          {section.id === 'task' && (
            <>
            <section class="case-section" id="task">
              <div class="container-wide">
                <div class="case-section__head">
                  <span class="case-section__num">{section.number} / ЗАДАЧА</span>
                  <div>
                    <h2>{config.taskTitle ?? 'С чем пришел клиент'}</h2>
                    <div class="case-prose">
                      {c.task.map((item: string) => <p>{item}</p>)}
                    </div>
                  </div>
                </div>
                <div class="case-approach">
                  {c.solutions.map((solution: any, index: number) => (
                    <article>
                      <span>{pad(index + 1)}</span>
                      <h3>{solution.title}</h3>
                      <p>{solution.text}</p>
                    </article>
                  ))}
                </div>
              </div>
            </section>
            <div class="case-midcta">
              <div class="container-wide case-midcta__inner">
                <p>Похожая задача? Напишите в Telegram, отвечу за пару часов.</p>
                <div class="case-midcta__links">
                  <a class="btn btn-dark" href={site.contact.telegram} target="_blank" rel="noopener">
                    Написать в Telegram <span class="arrow" aria-hidden="true">→</span>
                  </a>
                  <a class="case-midcta__service" href={service.href}>{service.cta} →</a>
                </div>
              </div>
            </div>
            </>
          )}

          {section.story && (
            <section class="case-comparison-section" id={section.story.id}>
              <div class="container-wide">
                <div class="case-section__head">
                  <span class="case-section__num">{section.number} / {section.story.label}</span>
                  <div>
                    <h2>{section.story.title}</h2>
                    {section.story.intro && <div class="case-prose"><p>{section.story.intro}</p></div>}
                  </div>
                </div>
                <div class="case-comparisons">
                  {section.story.items.map((item) => (
                    <article class="case-comparison">
                      <header class="case-comparison__head">
                        <span>{item.number}</span>
                        <div>
                          <h3>{item.title}</h3>
                          <p>{item.text}</p>
                        </div>
                      </header>
                      <div class={item.media.length === 3 ? 'case-process-grid' : 'case-comparison-grid'}>
                        {item.media.map((media) => (
                          <figure>
                            <figcaption>{media.caption}</figcaption>
                            <img src={media.src} alt={media.alt} loading="lazy" />
                          </figure>
                        ))}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          )}

          {section.id === 'result' && (
            <section class="case-section case-section--dark" id="result">
              <div class="container-wide">
                <div class="case-section__head">
                  <span class="case-section__num">{section.number} / РЕЗУЛЬТАТ</span>
                  <div>
                    <h2>{config.resultTitle ?? 'Что изменилось'}</h2>
                    {config.resultIntro && <div class="case-prose"><p>{config.resultIntro}</p></div>}
                  </div>
                </div>
                <div class="case-results">
                  {c.result.map((item: string, index: number) => (
                    <article class="case-result">
                      <strong>{pad(index + 1)}</strong>
                      <p>{item}</p>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          )}

          {section.group && section.group.layout === 'brand' && (
            <section class="case-section case-section--paper" id={section.group.id}>
              <div class="container-wide">
                <div class="case-section__head">
                  <span class="case-section__num">{section.number} / {section.group.label}</span>
                  <div>
                    <h2>{section.group.title}</h2>
                    {section.group.intro && <div class="case-prose"><p>{section.group.intro}</p></div>}
                  </div>
                </div>
                <div class="case-brand-grid">
                  {section.group.items.map((item) => (
                    <figure>
                      <img src={item.src} alt={item.label} loading="lazy" />
                      <figcaption>{item.label}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            </section>
          )}

          {section.group && section.group.layout !== 'brand' && (
            <section
              class={section.group.theme === 'paper' ? 'case-section case-section--paper' : 'case-media-section'}
              id={section.group.id}
            >
              <div class="container-wide">
                <div class="case-section__head">
                  <span class="case-section__num">{section.number} / {section.group.label}</span>
                  <div>
                    <h2>{section.group.title}</h2>
                    <div class="case-prose">
                      {section.group.intro && <p>{section.group.intro}</p>}
                      {section.group.interactive !== false && (
                        <p>Нажмите на изображение, чтобы открыть его во весь экран. Работают стрелки, клавиши ← → и миниатюры.</p>
                      )}
                    </div>
                  </div>
                </div>
                <div
                  class={`case-gallery${section.group.layout && section.group.layout !== 'default' ? ` case-gallery--${section.group.layout}` : ''}${section.group.ratio ? ' case-gallery--exact' : ''}`}
                >
                  {section.group.items.map((item) => (
                    <figure>
                      {section.group?.interactive === false ? (
                        <img src={item.src} alt={item.label} loading="lazy" />
                      ) : (
                        <button
                          type="button"
                          class="case-gallery-trigger js-lb"
                          style={section.group?.ratio ? `aspect-ratio: ${section.group.ratio}` : undefined}
                          data-lb-index={item.lightboxIndex}
                          aria-label={`Открыть изображение: ${item.label}`}
                        >
                          <img src={item.thumb ?? item.src} alt={item.label} loading="lazy" />
                          <span class="case-gallery-zoom" aria-hidden="true">Смотреть крупнее</span>
                        </button>
                      )}
                      <figcaption>{item.label}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            </section>
          )}

          {section.id === 'works' && (
            <section class="case-section case-section--paper" id="works">
              <div class="container-wide case-deliverables">
                <div>
                  <span class="case-section__num">{section.number} / СОСТАВ РАБОТ</span>
                  <h2>Что было сделано</h2>
                  <div class="case-credits">
                    <dl>
                      <div><dt>Клиент</dt><dd>{c.client}</dd></div>
                      {c.location && <div><dt>Город</dt><dd>{c.location}</dd></div>}
                      {c.year && <div><dt>Год</dt><dd>{c.year}</dd></div>}
                      {c.credits.map((credit: any) => (
                        <div><dt>{credit.role}</dt><dd>{credit.name}</dd></div>
                      ))}
                    </dl>
                  </div>
                </div>
                <ul>
                  {c.deliverables.map((item: string) => <li>{item}</li>)}
                </ul>
              </div>
            </section>
          )}

          {section.id === 'related' && config.related && (
            <section class="case-section case-related-section" id="related">
              <div class="container-wide">
                <span class="case-section__num">{section.number} / ЭТОТ ЖЕ КЛИЕНТ</span>
                <h2>{config.related.title}</h2>
                {config.related.intro && (
                  <div class="case-prose"><p>{config.related.intro}</p></div>
                )}
                <div class="case-related">
                  {relatedCases.map((item) => (
                    <a class="case-related__card" href={item.href}>
                      {item.cover && (
                        <span class="case-related__media">
                          <img src={item.cover} alt={item.coverAlt} loading="lazy" decoding="async" />
                        </span>
                      )}
                      <span class="case-related__body">
                        <small>{item.label}</small>
                        <strong>{item.title}</strong>
                        <span>{item.text}</span>
                      </span>
                      <span class="case-related__arrow" aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          )}
        </>
      ))}

      <section class="case-section" id="contact">
        <div class="container-wide">
          <div class="portfolio-cta">
            <h2>{cta.title}</h2>
            <p>{cta.text}</p>
            <div class="portfolio-cta__actions">
              <a class="btn btn-primary btn-lg" href={site.contact.telegram} target="_blank" rel="noopener">
                {cta.button} <span class="arrow" aria-hidden="true">→</span>
              </a>
              <a class="btn btn-ghost btn-lg" href={service.href}>{service.cta}</a>
            </div>
          </div>
        </div>
      </section>

      <a class="case-next" href={`/cases/${nextCase.slug}/`}>
        <span class="container-wide case-next__inner">
          <span>
            <small>Следующий кейс</small>
            <strong>{nextCase.title}</strong>
          </span>
          <span class="case-next__arrow" aria-hidden="true">→</span>
        </span>
      </a>
    </main>

    <Footer {...footer} />
  </div>

  {lightboxItems.length > 0 && <Lightbox items={lightboxItems} metrikaId={site.metrika.id} />}
</BaseLayout>
