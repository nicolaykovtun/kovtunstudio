---
// portfolio.astro — каталог портфолио.
// Два уровня: направление (упаковка / айдентика / сайты / презентации /
// оклейка) × сфера бизнеса клиента. Оба уровня — из taxonomy.yaml,
// кейсы — из cases.yaml, работы — из gallery.yaml.

import fs from 'node:fs';
import yaml from 'js-yaml';
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import RevealScript from '../components/RevealScript.astro';
import CtaBand from '../components/CtaBand.astro';
import { editorialCaseConfigs } from '../data/case-page-config';
import {
  caseOrderIndex,
  directionByCategory,
  servicePageByDirection,
  sphereBySegment,
} from '../data/case-catalog';
import { coverSrcset, coverSizes } from '../lib/covers';

// пути относительно корня проекта (CWD при сборке)
const site = yaml.load(fs.readFileSync('./src/data/site.yaml', 'utf8')) as any;
const gallery = yaml.load(fs.readFileSync('./src/data/gallery.yaml', 'utf8')) as any[];
const legacyCases = yaml.load(fs.readFileSync('./src/data/cases.yaml', 'utf8')) as any[];
const taxonomy = yaml.load(fs.readFileSync('./src/data/taxonomy.yaml', 'utf8')) as any;
const editorialEntries = (await getCollection('cases', ({ data }) => !data.draft))
  .filter((entry) => Boolean(entry.data.gallery) || Boolean(editorialCaseConfigs[entry.id]));

const pad = (n: number) => String(n).padStart(2, '0');
const plural = (n: number, one: string, few: string, many: string) => {
  const mod100 = n % 100;
  const mod10 = n % 10;
  if (mod100 >= 11 && mod100 <= 14) return many;
  if (mod10 === 1) return one;
  if (mod10 >= 2 && mod10 <= 4) return few;
  return many;
};

const editorialCases = editorialEntries.map((entry) => {
  const c = entry.data;
  const config = c.gallery
    ? {
        cover: {
          src: `${c.gallery.assetRoot}/${c.gallery.cover.src}`,
          alt: c.gallery.cover.alt,
        },
      }
    : editorialCaseConfigs[entry.id];

  return {
    slug: c.slug,
    name: c.shortTitle || c.client,
    title: c.title,
    accent: c.accent,
    category: c.categoryLabel,
    direction: directionByCategory[c.category],
    sphere: c.segmentLabel,
    sphereKey: sphereBySegment[c.segment] ?? c.segment,
    details: [c.year, c.location].filter(Boolean).join(' · '),
    coverSrc: config.cover.src,
    coverAlt: config.cover.alt,
    countLabel: c.year,
  };
});

const cases = [
  // У кейсов оклейки в cases.yaml нет года, поэтому подпись на карточке
  // пустая: раньше там стояло число ракурсов из gallery.yaml, но это виды
  // одной работы, а не отдельные работы.
  ...legacyCases.map((c) => ({
    ...c,
    details: c.vehicles,
    coverSrc: `/assets/portfolio/thumb/${c.cover}.webp`,
    coverAlt: c.images.find((image: any) => image.id === c.cover)?.caption ?? c.title,
    countLabel: '',
  })),
  ...editorialCases,
].sort((a, b) => caseOrderIndex(a.slug) - caseOrderIndex(b.slug));

// Числительное словом для лида: в тексте «13 кейсов» читается хуже, чем «тринадцать».
const numerals = [
  'ноль', 'один', 'два', 'три', 'четыре', 'пять', 'шесть', 'семь', 'восемь', 'девять',
  'десять', 'одиннадцать', 'двенадцать', 'тринадцать', 'четырнадцать', 'пятнадцать',
  'шестнадцать', 'семнадцать', 'восемнадцать', 'девятнадцать', 'двадцать',
];
const casesWord = numerals[cases.length] ?? String(cases.length);

const caseBySlug = Object.fromEntries(cases.map(c => [c.slug, c]));
const coverIds = new Set(legacyCases.map(c => c.cover));

// Работы, обогащенные направлением и сферой (через свой кейс)
const works = gallery.map(g => ({
  ...g,
  direction: caseBySlug[g.project]?.direction,
  sphereKey: caseBySlug[g.project]?.sphereKey,
}));

// Кол-во работ на кейс
const countByProject = Object.fromEntries(
  cases.map(c => [c.slug, gallery.filter(g => g.project === c.slug).length])
);

// Направления: счетчики кейсов и работ (пустые — «скоро»)
const directions = taxonomy.directions.map((d: any, i: number) => {
  const dirCases = cases.filter(c => c.direction === d.key);
  return {
    ...d,
    num: pad(i + 1),
    caseCount: dirCases.length,
    workCount: dirCases.reduce((s, c) => s + (countByProject[c.slug] || 0), 0),
  };
});
const activeDirections = directions.filter((d: any) => d.caseCount > 0);

// Подводка к списку направлений. Раньше строка была зашита руками — «уже открыты
// сайты, презентации и оклейка авто» — и устарела, как только упаковка набрала
// кейсы. Считаем ее из тех же данных, что и сам список.
const listWords = (items: string[]) =>
  items.length < 2 ? (items[0] ?? '') : items.slice(0, -1).join(', ') + ' и ' + items.at(-1);
const openDirections = activeDirections.length === directions.length
  ? 'Открыты все разделы: в каждом есть разобранные кейсы.'
  : `Уже открыты ${listWords(activeDirections.map((d: any) => d.label.toLowerCase()))}; остальные разделы появятся после переноса архива.`;

// Сферы: в фильтр — только те, где есть работы
const spheres = taxonomy.spheres
  .map((s: any) => ({
    ...s,
    caseCount: cases.filter(c => c.sphereKey === s.key).length,
    workCount: works.filter(w => w.sphereKey === s.key).length,
  }))
  .filter((s: any) => s.caseCount > 0 || s.workCount > 0);

// Лайтбокс — весь каталог, в порядке gallery.yaml
const lbItems = gallery.map(g => ({
  src: `/assets/portfolio/full/${g.id}.webp`,
  label: g.alt,
}));

const seoTitle = 'Портфолио: кейсы дизайна для бизнеса · Kovtun.studio';
const seoDescription =
  `Портфолио Kovtun.studio: ${cases.length} подробных кейсов по сайтам, презентациям, брошюрам ` +
  `и оклейке авто. Задачи, решения, макеты и ${gallery.length} работ крупным планом.`;
---
<BaseLayout title={seoTitle} description={seoDescription} canonicalPath="/portfolio/">
  <Header nav={site.nav} phone={site.contact.phone} phoneTel={site.contact.phoneTel} telegramUrl={site.contact.telegram} maxUrl={site.contact.max} />
  <main id="main-content">

    <!-- ── Шапка каталога ─────────────────────────────────────────── -->
    <section class="p-hero">
      <div class="container-wide">
        <p class="p-crumb reveal">
          <a href="/">Главная</a><span aria-hidden="true">/</span><span>Портфолио</span>
        </p>
        <h1 class="reveal" style="--reveal-delay: 60ms">
          Пять направлений.<br>
          <em class="accent">Один почерк.</em>
        </h1>
        <p class="p-lede reveal" style="--reveal-delay: 120ms">
          Упаковка, айдентика, сайты, презентации и оклейка транспорта.
          В каталоге уже {casesWord} {plural(cases.length, 'подробный кейс', 'подробных кейса', 'подробных кейсов')}:
          от фирменного стиля и сайтов до корпоративных брошюр и транспорта.
          Откройте проект целиком или рассмотрите макеты оклейки во весь экран.
        </p>
        <div class="p-meta reveal" style="--reveal-delay: 180ms">
          <div class="item"><span class="num">{pad(directions.length)}</span><span class="lbl">Направлений работы</span></div>
          <div class="item"><span class="num">{pad(cases.length)}</span><span class="lbl">Проектов в каталоге</span></div>
          <div class="item"><span class="num">{pad(spheres.length)}<span class="accent">+</span></span><span class="lbl">Сфер бизнеса клиентов</span></div>
        </div>
      </div>
    </section>

    <!-- ── Направления ────────────────────────────────────────────── -->
    <section class="section-tight p-dirs">
      <div class="container-wide">
        <div class="section-head">
          <h2 class="reveal">Направления<br>каталога</h2>
          <p class="aside reveal" style="--reveal-delay: 80ms">
            Пять дисциплин одной студии. {openDirections}
          </p>
        </div>
        <ol class="dir-list">
          {directions.map((d: any, i: number) => d.caseCount > 0 ? (
            <li class="dir-item reveal" style={`--reveal-delay: ${i * 50}ms`}>
              <a class="dir-row" href="#cases" data-goto-direction={d.key}>
                <span class="dr-num" aria-hidden="true">{d.num}</span>
                <span class="dr-name">{d.label}</span>
                <span class="dr-count">
                  {d.caseCount} {plural(d.caseCount, 'кейс', 'кейса', 'кейсов')}
                </span>
                <span class="dr-arrow" aria-hidden="true">↓</span>
              </a>
              {servicePageByDirection[d.key] && (
                <a class="dr-service" href={servicePageByDirection[d.key].href}>
                  Цены и процесс <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ) : (
            <li class="reveal" style={`--reveal-delay: ${i * 50}ms`}>
              <div class="dir-row is-soon">
                <span class="dr-num" aria-hidden="true">{d.num}</span>
                <span class="dr-name">{d.label}</span>
                <span class="dr-soon">Скоро</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Кейсы + фильтр ─────────────────────────────────────────── -->
    <section class="section-tight p-cases" id="cases">
      <div class="container-wide">
        <div class="section-head">
          <h2 class="reveal">Кейсы —<br>проекты целиком</h2>
          <p class="aside reveal" style="--reveal-delay: 80ms">
            Задача, решение и все макеты одного проекта на отдельной
            странице. Фильтр действует и на кейсы, и на сетку работ ниже.
          </p>
        </div>

        <div class="filter-panel reveal">
          <div class="filter-group filter-group--direction" role="group" aria-label="Фильтр по направлению">
            <span class="fg-label">Направление</span>
            <div class="fg-chips">
              <button type="button" class="chip is-active" data-dim="direction" data-value="all">Все</button>
              {activeDirections.map((d: any) => (
                <button type="button" class="chip" data-dim="direction" data-value={d.key}>
                  {d.label} <span class="chip-n">{d.caseCount}</span>
                </button>
              ))}
            </div>
          </div>
          <div class="filter-group filter-group--sphere">
            <span class="fg-label" id="sphere-label">Сфера</span>
            <div class="fg-select-wrap" data-sphere-select>
              <button
                type="button"
                class="fg-select-trigger"
                id="sphere-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="sphere-listbox"
                aria-labelledby="sphere-label"
              >
                <span class="fg-select-value" data-select-value>Все сферы</span>
                <span class="fg-select-arrow" aria-hidden="true">▾</span>
              </button>
              <ul class="fg-select-list" id="sphere-listbox" role="listbox" aria-labelledby="sphere-label" tabindex="-1" hidden>
                <li role="option" class="fg-select-option is-selected" data-value="all" aria-selected="true">Все сферы</li>
                {spheres.map((s: any) => (
                  <li role="option" class="fg-select-option" data-value={s.key} aria-selected="false">{s.label} · {s.caseCount}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="case-index" id="case-index">
          {cases.map((c, i) => (
            <a
              class="case-row reveal"
              href={`/cases/${c.slug}/`}
              data-direction={c.direction}
              data-sphere={c.sphereKey}
              style={`--reveal-delay: ${i * 60}ms; --case-row-accent: ${c.accent}`}
            >
              <span class="cr-num" aria-hidden="true">{pad(i + 1)}</span>
              <span class="cr-thumb">
                <img src={c.coverSrc} srcset={coverSrcset(c.coverSrc)} sizes={coverSizes} alt={c.name} loading={i < 3 ? 'eager' : 'lazy'} width="800" height="447" />
              </span>
              <span class="cr-body">
                <span class="cr-name">{c.name}</span>
                <span class="cr-meta">{c.sphere} · {c.details}</span>
              </span>
              <span class="cr-tags">
                <span class="cr-cat">{c.category}</span>
                {c.countLabel && <span class="cr-count">{c.countLabel}</span>}
              </span>
              <span class="cr-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <p class="works-empty" id="cases-empty" hidden>По этому фильтру кейсов пока нет.</p>
      </div>
    </section>

    <!-- ── Все работы ─────────────────────────────────────────────── -->
    <section class="section p-grid" id="works">
      <div class="container-wide">
        <div class="section-head">
          <h2 class="reveal">Все работы<br>подряд</h2>
          <p class="aside reveal" style="--reveal-delay: 80ms">
            Кликните на изображение — откроется во весь экран.
            Листайте стрелками или клавишами ← →.
          </p>
        </div>

        <div class="works-grid is-collapsed" id="works-grid">
          {works.map((g, i) => (
            <button
              type="button"
              class:list={['work-tile', 'js-lb', 'reveal', { 'is-featured': coverIds.has(g.id) }]}
              data-lb-index={i}
              data-direction={g.direction}
              data-sphere={g.sphereKey}
              style={`--reveal-delay: ${(i % 4) * 50}ms`}
              aria-label={`Открыть работу: ${g.alt}`}
            >
              <img
                src={`/assets/portfolio/thumb/${g.id}.webp`}
                alt={g.alt}
                loading={i < 4 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                width="800"
                height="447"
              />
              <span class="wt-shade" aria-hidden="true"></span>
              <span class="wt-label">
                <span class="wt-project">{caseBySlug[g.project]?.name}</span>
                {g.alt}
              </span>
              <span class="hover-zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M11 8v6M8 11h6"/><path d="M16 16l4 4"/></svg>
              </span>
            </button>
          ))}
        </div>
        <p class="works-empty" id="works-empty" hidden>По этому фильтру работ пока нет.</p>
        <div class="gallery-more" id="works-more-wrap">
          <button type="button" class="btn btn-dark btn-lg" id="works-more">Показать все ракурсы <span class="arrow" aria-hidden="true">→</span></button>
        </div>
      </div>
    </section>

    <CtaBand
      title="Есть задача<br>по дизайну?"
      text="Опишите проект — за пару часов отвечу и подскажу формат: от макета оклейки до фирменного стиля и презентации."
      primaryLabel="Обсудить проект"
      primaryHref="/#contact"
      telegramUrl={site.contact.telegram}
    />
  </main>
  <Footer {...site.footer} />

  <Lightbox items={lbItems} metrikaId={site.metrika.id} />
  <RevealScript />

  <script is:inline define:vars={{ METRIKA_ID: site.metrika.id }}>
    // Двухуровневый фильтр: направление × сфера.
    // Применяется одновременно к кейсам (#case-index) и работам (#works-grid).
    (function () {
      "use strict";
      var params = new URLSearchParams(window.location.search);
      var state = {
        direction: params.get("direction") || "all",
        sphere: params.get("sphere") || "all",
      };
      var chips = document.querySelectorAll(".filter-panel .chip");
      var sphereWrap = document.querySelector("[data-sphere-select]");
      var sphereTrigger = document.getElementById("sphere-trigger");
      var sphereList = document.getElementById("sphere-listbox");
      var sphereValueLabel = sphereTrigger && sphereTrigger.querySelector("[data-select-value]");
      var sphereOptions = sphereList
        ? Array.prototype.slice.call(sphereList.querySelectorAll(".fg-select-option"))
        : [];
      var rows = document.querySelectorAll("#case-index .case-row");
      var tiles = document.querySelectorAll("#works-grid .work-tile");
      var casesEmpty = document.getElementById("cases-empty");
      var worksEmpty = document.getElementById("works-empty");
      var worksMore = document.getElementById("works-more");
      if (worksMore) {
        worksMore.addEventListener("click", function () {
          document.getElementById("works-grid").classList.remove("is-collapsed");
          document.getElementById("works-more-wrap").hidden = true;
        });
      }

      function matches(el) {
        return (state.direction === "all" || el.dataset.direction === state.direction)
            && (state.sphere === "all" || el.dataset.sphere === state.sphere);
      }

      function syncSphereUI() {
        var activeOption = null;
        Array.prototype.forEach.call(sphereOptions, function (opt) {
          var isSelected = opt.dataset.value === state.sphere;
          opt.classList.toggle("is-selected", isSelected);
          opt.setAttribute("aria-selected", String(isSelected));
          if (isSelected) activeOption = opt;
        });
        if (activeOption && sphereValueLabel) {
          sphereValueLabel.textContent = activeOption.textContent;
        }
      }

      function apply() {
        var visRows = 0, visTiles = 0;
        Array.prototype.forEach.call(rows, function (el) {
          var show = matches(el);
          el.classList.toggle("is-hidden", !show);
          if (show) visRows++;
        });
        Array.prototype.forEach.call(tiles, function (el) {
          var show = matches(el);
          el.classList.toggle("is-hidden", !show);
          if (show) visTiles++;
        });
        casesEmpty.hidden = visRows > 0;
        worksEmpty.hidden = visTiles > 0;
        Array.prototype.forEach.call(chips, function (c) {
          c.classList.toggle("is-active", state[c.dataset.dim] === c.dataset.value);
        });
        syncSphereUI();
      }

      function reportFilterGoal() {
        if (typeof window.ksAnalyticsGoal === "function") {
          window.ksAnalyticsGoal("portfolio_filter", {
            direction: state.direction, sphere: state.sphere
          });
        }
      }

      Array.prototype.forEach.call(chips, function (chip) {
        chip.addEventListener("click", function () {
          state[chip.dataset.dim] = chip.dataset.value;
          apply();
          reportFilterGoal();
        });
      });

      // Кастомный дропдаун «Сфера»: кнопка + список, чтобы полностью
      // контролировать подсветку (нативный <select> ее не отдает).
      if (sphereWrap && sphereTrigger && sphereList) {
        var openSphereList = function () {
          sphereList.hidden = false;
          sphereTrigger.setAttribute("aria-expanded", "true");
        };
        var closeSphereList = function () {
          sphereList.hidden = true;
          sphereTrigger.setAttribute("aria-expanded", "false");
        };
        var selectSphere = function (opt) {
          state.sphere = opt.dataset.value;
          apply();
          reportFilterGoal();
        };

        sphereTrigger.addEventListener("click", function () {
          if (sphereTrigger.getAttribute("aria-expanded") === "true") {
            closeSphereList();
          } else {
            openSphereList();
          }
        });

        sphereTrigger.addEventListener("keydown", function (e) {
          if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openSphereList();
            var toFocus = sphereList.querySelector(".is-selected") || sphereOptions[0];
            if (toFocus) toFocus.focus();
          } else if (e.key === "Escape") {
            closeSphereList();
          }
        });

        Array.prototype.forEach.call(sphereOptions, function (opt, i) {
          opt.setAttribute("tabindex", "-1");
          opt.addEventListener("click", function () {
            selectSphere(opt);
            closeSphereList();
            sphereTrigger.focus();
          });
          opt.addEventListener("keydown", function (e) {
            if (e.key === "ArrowDown") {
              e.preventDefault();
              var next = sphereOptions[i + 1];
              if (next) next.focus();
            } else if (e.key === "ArrowUp") {
              e.preventDefault();
              var prev = sphereOptions[i - 1];
              if (prev) prev.focus(); else sphereTrigger.focus();
            } else if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              selectSphere(opt);
              closeSphereList();
              sphereTrigger.focus();
            } else if (e.key === "Escape") {
              closeSphereList();
              sphereTrigger.focus();
            }
          });
        });

        document.addEventListener("click", function (e) {
          if (!sphereWrap.contains(e.target)) closeSphereList();
        });
      }

      // Клик по направлению в списке — установить фильтр и проскроллить к кейсам
      Array.prototype.forEach.call(document.querySelectorAll("[data-goto-direction]"), function (link) {
        link.addEventListener("click", function () {
          state.direction = link.dataset.gotoDirection;
          state.sphere = "all";
          apply();
        });
      });

      // Пришли по ссылке с ?direction=/?sphere= (например, со страницы /services/) —
      // применяем фильтр сразу и подскрестываем к разделу кейсов.
      if (state.direction !== "all" || state.sphere !== "all") {
        apply();
        var casesSection = document.getElementById("cases");
        if (casesSection) casesSection.scrollIntoView({ behavior: "instant", block: "start" });
      }
    })();
  </script>
</BaseLayout>

<style>
  /* ── Шапка каталога ─────────────────────────────────────────────── */
  .p-hero {
    padding: 96px 0 88px;
    border-bottom: 1px solid var(--line-1);
  }
  .p-crumb {
    font: 700 12px/1.2 var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-3);
    display: flex; align-items: center; gap: 12px;
    margin: 0 0 40px;
  }
  .p-crumb a {
    color: var(--fg-3);
    border: 0;
    transition: color var(--dur-fast);
  }
  .p-crumb a:hover { color: var(--ks-red); }
  .p-crumb span[aria-hidden] { color: var(--line-2); }
  .p-crumb span:last-child { color: var(--fg-1); }

  .p-hero h1 {
    font: 800 clamp(44px, 7vw, 104px)/0.98 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--fg-1);
    margin: 0 0 28px;
  }
  .p-hero h1 em { font-style: normal; }
  .p-lede {
    font: 400 clamp(16px, 1.3vw, 19px)/1.55 var(--font-body);
    color: var(--fg-3);
