---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WhatGrid from '../components/WhatGrid.astro';
import Pricing from '../components/Pricing.astro';
import { caseOrderIndex } from '../data/case-catalog';
import ProcessSteps from '../components/ProcessSteps.astro';
import FounderSection from '../components/FounderSection.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const dataDir = path.resolve('./src/data');
const site = yaml.load(fs.readFileSync(path.join(dataDir, 'site.yaml'), 'utf8')) as any;
const tiers = yaml.load(fs.readFileSync(path.join(dataDir, 'tiers.yaml'), 'utf8')) as any[];
const faq = yaml.load(fs.readFileSync(path.join(dataDir, 'faq.yaml'), 'utf8')) as any[];
const legacyCases = yaml.load(fs.readFileSync(path.join(dataDir, 'cases.yaml'), 'utf8')) as any[];

// Локальная навигация страницы (как у /presentations/) — этот лендинг
// больше не главная, поэтому не использует общий site.nav.
const nav = [
  { href: '#what', label: 'Что делаю' },
  { href: '#pricing', label: 'Цены' },
  { href: '#process', label: 'Процесс' },
  { href: '#faq', label: 'FAQ' },
];

const footer = {
  ...site.footer,
  columns: [
    {
      title: 'Страница',
      links: [
        { href: '#what', label: 'Что делаю' },
        { href: '#pricing', label: 'Цены' },
        { href: '#process', label: 'Процесс' },
        { href: '#faq', label: 'FAQ' },
      ],
    },
    site.footer.columns[1],
    {
      title: 'Прочее',
      links: [
        { href: '/', label: 'Главная' },
        { href: '/portfolio/', label: 'Портфолио' },
        { href: '/presentations/', label: 'Презентации' },
        { href: '/packaging/', label: 'Упаковка' },
        { href: '/blog/', label: 'Мысли' },
        { href: '#contact', label: 'Оставить заявку' },
      ],
    },
  ],
};

// Кейсы оклейки — карточками, как на /presentations/. Раньше здесь была
// сетка отдельных ракурсов в лайтбоксе: 28 картинок без задачи и решения.
// Кейсы лежат в cases.yaml, порядок — канонический из каталога.
const wrapCases = legacyCases
  .filter((c: any) => c.direction === 'wrap')
  .sort((a: any, b: any) => caseOrderIndex(a.slug) - caseOrderIndex(b.slug))
  .map((c: any) => ({
    slug: c.slug,
    title: c.name,
    meta: [c.sphere, c.vehicles].filter(Boolean).join(' · '),
    coverSrc: `/assets/portfolio/full/${c.cover}.webp`,
    coverAlt:
      c.images.find((image: any) => image.id === c.cover)?.caption ?? c.title,
  }));

// JSON-LD этой услуги — раньше жил в BaseLayout и подключался только на
// главной; теперь страница сама отвечает за свою разметку (см. правку
// BaseLayout: общий там только LocalBusiness).
const ldService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/car-wrap/#service`,
  serviceType: 'Дизайн оклейки автомобиля',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'Country', name: 'Россия' },
  audience: { '@type': 'BusinessAudience', audienceType: site.business.serviceAudience },
  offers: tiers.map((t: any) => ({
    '@type': 'Offer',
    name: t.offerShortName,
    price: String(t.price),
    priceCurrency: 'RUB',
  })),
};

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: any) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// Раньше секция портфолио была галереей картинок, и разметка описывала ее как
// ImageGallery. Теперь на странице карточки кейсов, поэтому и разметка — список
// работ со ссылками на разборы.
const ldPortfolioCases = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${site.url}/car-wrap/#portfolio`,
  name: 'Кейсы дизайна оклейки авто Kovtun.studio',
  url: `${site.url}/car-wrap/`,
  numberOfItems: wrapCases.length,
  itemListElement: wrapCases.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: item.title,
      url: `${site.url}/cases/${item.slug}/`,
      image: `${site.url}${item.coverSrc}`,
      creator: { '@id': `${site.url}/#business` },
    },
  })),
};
---
<BaseLayout
  title="Дизайн оклейки авто во Владивостоке — макеты для коммерческого транспорта · Kovtun.studio"
  description="Разрабатываю макеты оклейки для легковых, фургонов и коммерческого транспорта. От 10 000 ₽ — простой брендинг до 25 000 ₽ — имиджевой рекламной концепции. Файлы готовы под печать. Заявка в Telegram."
  keywords="дизайн оклейки авто, макет оклейки, брендинг авто, реклама на автомобиле, оклейка коммерческого транспорта, дизайн под пленку, Владивосток, Kovtun.studio"
  canonicalPath="/car-wrap/"
  ogTitle="Дизайн оклейки авто — макеты для коммерческого транспорта"
  ogDescription="Макеты оклейки от 10 000 ₽: брендинг, реклама, имиджевая концепция. Под печать, без сюрпризов в продакшене. Заявка — в Telegram @nikolaikovtun."
  structuredData={[ldService, ldFaq, ldPortfolioCases]}
>
  <Header nav={nav} phone={site.contact.phone} phoneTel={site.contact.phoneTel} telegramUrl={site.contact.telegram} maxUrl={site.contact.max} />
  <main id="main-content">
    <Hero {...site.hero} />
    <Marquee {...site.marquee} />
    <WhatGrid {...site.whatDo} />
    <Pricing {...site.pricing} tiers={tiers} />
    <section class="section section-tight" id="cases">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2 set:html={site.cases.title}></h2>
          </div>
          <p class="aside">{site.cases.aside}</p>
        </div>

        <div class="pcase-grid pcase-grid--three">
          {wrapCases.map((item, i) => (
            <a class="pcase" href={`/cases/${item.slug}/`}>
              <span class="pcase__media">
                <img
                  src={item.coverSrc}
                  alt={item.coverAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  width="2400"
                  height="1340"
                />
              </span>
              <span class="pcase__body">
                <strong>{item.title}</strong>
                <span class="pcase__meta">{item.meta}</span>
              </span>
              <span class="pcase__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="gallery-more">
          <a class="btn btn-dark btn-lg" href="/portfolio/?direction=wrap">
            {site.cases.ctaAll} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
    <ProcessSteps {...site.process} />
    <FounderSection data={site.founderSection} />
    <FAQ {...site.faqSection} telegramUrl={site.contact.telegram} items={faq} />
    <ContactForm data={site.cta} telegramUrl={site.contact.telegram} telegramHandle={site.contact.telegramHandle} maxUrl={site.contact.max} maxHandle={site.contact.maxHandle} />
  </main>
  <Footer {...footer} />

  <script
    is:inline
    define:vars={{
      METRIKA_ID: site.metrika.id,
      TELEGRAM_URL: site.contact.telegram,
      MAX_URL: site.contact.max,
      CONSENT_MARKER: `Согласие на обработку персональных данных: да · редакция ${site.legal.policyVersion} от ${site.legal.policyDate} · ${site.url}/consent/`,
    }}
  >
    (function () {
      "use strict";

      /* ─── Цели Метрики ─── */
      function goal(name, params) {
        if (typeof window.ksAnalyticsGoal === "function") window.ksAnalyticsGoal(name, params);
      }

      /* ─── Сборка сообщения и ссылки на мессенджер ─── */
      function buildMessage(d) {
        var lines = ["Здравствуйте! Хочу обсудить дизайн оклейки авто.", ""];
        if (d.name) lines.push("Имя: " + d.name);
        if (d.car) lines.push("Авто: " + d.car);
        if (d.message) lines.push("\nЗадача:\n" + d.message);
        if (d.leadId) lines.push("\nЗаявка ID: " + d.leadId);
        lines.push("\n" + CONSENT_MARKER);
        return lines.join("\n");
      }
      function buildTelegramURL(text) {
        return TELEGRAM_URL + "?text=" + encodeURIComponent(text);
      }
      function buildMaxURL(text) {
        // MAX деep-link с текстом. На текущий момент max.ru не поддерживает
        // ?text= параметр напрямую. Открываем чат, текст копируем в буфер.
        return MAX_URL;
      }

      /* ─── Lead form ─── */
      var form = document.getElementById("lead-form");
      var fName = document.getElementById("f-name");
      var fCar = document.getElementById("f-car");
      var fMessage = document.getElementById("f-message");
      var errName = document.getElementById("err-name");
      var errCar = document.getElementById("err-car");
      var fields = document.getElementById("form-fields");
      var success = document.getElementById("form-success");
      var successText = document.getElementById("success-text");
      var reopen = document.getElementById("reopen-messenger");
      var copyBlock = document.getElementById("copy-text-block");
      var copyArea = document.getElementById("copy-text-area");
      var copyBtn = document.getElementById("copy-text-btn");
      var copyBtnLabel = document.getElementById("copy-text-btn-label");

      function setError(node, msg) {
        if (msg) { node.textContent = msg; node.hidden = false; }
        else { node.textContent = ""; node.hidden = true; }
      }

      function validate() {
        var ok = true;
        if (!fName.value.trim()) { setError(errName, "Как к вам обращаться?"); ok = false; }
        else setError(errName, "");
        if (!fCar.value.trim()) { setError(errCar, "Марка и модель — чтобы прикинуть объем"); ok = false; }
        else setError(errCar, "");
        return ok;
      }

      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          if (!validate()) return;

          // По нажатой кнопке определяем целевой мессенджер
          var target = (e.submitter && e.submitter.dataset.target) || "telegram";
          var label = target === "max" ? "MAX" : "Telegram";
          var leadId = typeof window.kovtunLeadEvent === "function"
            ? window.kovtunLeadEvent({ messenger: label })
            : "";
          var text = buildMessage({
            name: fName.value.trim(),
            car: fCar.value.trim(),
            message: fMessage.value.trim(),
            leadId: leadId
          });

          var url, goalName;
          if (target === "max") {
            url = buildMaxURL(text);
            label = "MAX";
            goalName = "car_wrap_lead_max";
            // MAX не поддерживает pre-filled text в URL — показываем
            // текст явно с кнопкой "Скопировать" + пробуем сразу положить в буфер.
            copyArea.value = text;
            copyBlock.hidden = false;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).catch(function () {});
            }
            successText.textContent = "MAX откроется в новой вкладке. Скопируй текст заявки кнопкой ниже и вставь в чат.";
          } else {
            url = buildTelegramURL(text);
            label = "Telegram";
            goalName = "car_wrap_lead_submit";
            copyBlock.hidden = true;
            successText.textContent = "Открылся Telegram с заполненным сообщением. Нажмите «отправить» в чате — и я отвечу в течение пары часов.";
          }

          window.open(url, "_blank", "noopener,noreferrer");
          reopen.href = url;
          // Меняем текст у reopen — оставляем span со стрелкой
          reopen.innerHTML = "Открыть " + label + " еще раз <span class=\"arrow\" aria-hidden=\"true\">→</span>";
          fields.hidden = true;
          success.hidden = false;
          form.classList.add("is-success");
          goal(goalName, { car: fCar.value.trim().slice(0, 40) });
        });
      }

      /* ─── Копирование текста заявки кнопкой ─── */
      if (copyBtn) {
        copyBtn.addEventListener("click", function () {
          var text = copyArea.value;
          var done = function () {
            copyBtnLabel.textContent = "Скопировано ✓";
            setTimeout(function () { copyBtnLabel.textContent = "Скопировать текст"; }, 2000);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(function () {
              // Fallback: выделить и execCommand
              copyArea.select();
              try { document.execCommand("copy"); done(); } catch (e) {}
            });
          } else {
            copyArea.select();
            try { document.execCommand("copy"); done(); } catch (e) {}
          }
        });
      }

      var resetBtn = document.getElementById("form-reset");
      if (resetBtn) {
        resetBtn.addEventListener("click", function () {
          fName.value = ""; fCar.value = ""; fMessage.value = "";
          setError(errName, ""); setError(errCar, "");
          success.hidden = true;
          fields.hidden = false;
          form.classList.remove("is-success");
        });
      }

      /* ─── Tier "Выбрать пакет" → префилл формы + скролл + цель ─── */
      Array.prototype.forEach.call(document.querySelectorAll(".tier-cta [data-tier]"), function (btn) {
        btn.addEventListener("click", function () {
          if (success && success.hidden === false) { success.hidden = true; fields.hidden = false; }
          if (fMessage) fMessage.value = "Интересует пакет: " + btn.dataset.tier + ".";
          var el = document.getElementById("contact");
          if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
          goal("car_wrap_package_pick", { pkg: btn.dataset.tier || "unknown" });
        });
      });

      /* ─── Цель: телефонный CTA в шапке ─── */
      Array.prototype.forEach.call(document.querySelectorAll('a[href^="tel:"]'), function (link) {
        link.addEventListener("click", function () { goal("cta_phone"); });
      });

      /* ─── Цель: прямые ссылки на Telegram ─── */
      Array.prototype.forEach.call(document.querySelectorAll('a[href^="https://t.me/"]'), function (link) {
        link.addEventListener("click", function () { goal("telegram_direct"); });
      });

      /* ─── Цель: прямые ссылки на MAX ─── */
      Array.prototype.forEach.call(document.querySelectorAll('a[href^="https://max.ru/"]'), function (link) {
        link.addEventListener("click", function () { goal("max_direct"); });
      });

      /* ─── Цель: клик по hero CTA "Обсудить проект" ─── */
      Array.prototype.forEach.call(document.querySelectorAll('a[href="#contact"]'), function (link) {
        link.addEventListener("click", function () { goal("car_wrap_cta_main"); });
      });
    })();
  </script>
</BaseLayout>
