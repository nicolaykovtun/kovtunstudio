---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WhatGrid from '../components/WhatGrid.astro';
import Pricing from '../components/Pricing.astro';
import { caseOrderIndex } from '../data/case-catalog';
import { servicePageNav } from '../lib/site-nav';
import ProcessSteps from '../components/ProcessSteps.astro';
import FounderSection from '../components/FounderSection.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const dataDir = path.resolve('./src/data');
const site = yaml.load(fs.readFileSync(path.join(dataDir, 'site.yaml'), 'utf8')) as any;
const tiers = yaml.load(fs.readFileSync(path.join(dataDir, 'tiers.yaml'), 'utf8')) as any[];
const faq = yaml.load(fs.readFileSync(path.join(dataDir, 'faq.yaml'), 'utf8')) as any[];
const legacyCases = yaml.load(fs.readFileSync(path.join(dataDir, 'cases.yaml'), 'utf8')) as any[];

// Локальная навигация страницы (как у /presentations/) — этот лендинг
// больше не главная, поэтому не использует общий site.nav.
const nav = servicePageNav(site, [
  { href: '#what', label: 'Что делаю' },
  { href: '#pricing', label: 'Цены' },
  { href: '#process', label: 'Процесс' },
  { href: '#faq', label: 'FAQ' },
]);

const footer = {
  ...site.footer,
  columns: [
    {
      title: 'Страница',
      links: [
        { href: '#what', label: 'Что делаю' },
        { href: '#pricing', label: 'Цены' },
        { href: '#process', label: 'Процесс' },
        { href: '#faq', label: 'FAQ' },
      ],
    },
    site.footer.columns[1],
    {
      title: 'Прочее',
      links: [
        { href: '/', label: 'Главная' },
        { href: '/portfolio/', label: 'Портфолио' },
        { href: '/presentations/', label: 'Презентации' },
        { href: '/packaging/', label: 'Упаковка' },
        { href: '/blog/', label: 'Мысли' },
        { href: '#contact', label: 'Оставить заявку' },
      ],
    },
  ],
};

// Кейсы оклейки — карточками, как на /presentations/. Раньше здесь была
// сетка отдельных ракурсов в лайтбоксе: 28 картинок без задачи и решения.
// Кейсы лежат в cases.yaml, порядок — канонический из каталога.
const wrapCases = legacyCases
  .filter((c: any) => c.direction === 'wrap')
  .sort((a: any, b: any) => caseOrderIndex(a.slug) - caseOrderIndex(b.slug))
  .map((c: any) => ({
    slug: c.slug,
    title: c.name,
    meta: [c.sphere, c.vehicles].filter(Boolean).join(' · '),
    coverSrc: `/assets/portfolio/full/${c.cover}.webp`,
    coverAlt:
      c.images.find((image: any) => image.id === c.cover)?.caption ?? c.title,
  }));

// JSON-LD этой услуги — раньше жил в BaseLayout и подключался только на
// главной; теперь страница сама отвечает за свою разметку (см. правку
// BaseLayout: общий там только LocalBusiness).
const ldService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/car-wrap/#service`,
  serviceType: 'Дизайн оклейки автомобиля',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'Country', name: 'Россия' },
  audience: { '@type': 'BusinessAudience', audienceType: site.business.serviceAudience },
  offers: tiers.map((t: any) => ({
    '@type': 'Offer',
    name: t.offerShortName,
    price: String(t.price),
    priceCurrency: 'RUB',
  })),
};

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: any) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// Раньше секция портфолио была галереей картинок, и разметка описывала ее как
// ImageGallery. Теперь на странице карточки кейсов, поэтому и разметка — список
// работ со ссылками на разборы.
const ldPortfolioCases = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${site.url}/car-wrap/#portfolio`,
  name: 'Кейсы дизайна оклейки авто Kovtun.studio',
  url: `${site.url}/car-wrap/`,
  numberOfItems: wrapCases.length,
  itemListElement: wrapCases.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: item.title,
      url: `${site.url}/cases/${item.slug}/`,
      image: `${site.url}${item.coverSrc}`,
      creator: { '@id': `${site.url}/#business` },
    },
  })),
};
---
<BaseLayout
  title="Дизайн оклейки авто во Владивостоке — макеты для коммерческого транспорта · Kovtun.studio"
  description="Разрабатываю макеты оклейки для легковых, фургонов и коммерческого транспорта. От 10 000 ₽ — простой брендинг до 25 000 ₽ — имиджевой рекламной концепции. Файлы готовы под печать. Заявка в Telegram."
  keywords="дизайн оклейки авто, макет оклейки, брендинг авто, реклама на автомобиле, оклейка коммерческого транспорта, дизайн под пленку, Владивосток, Kovtun.studio"
  canonicalPath="/car-wrap/"
  ogTitle="Дизайн оклейки авто — макеты для коммерческого транспорта"
  ogDescription="Макеты оклейки от 10 000 ₽: брендинг, реклама, имиджевая концепция. Под печать, без сюрпризов в продакшене. Заявка — в Telegram @nikolaikovtun."
  ogImage="/og.jpg"
  ogImageAlt="BMW Z4 в рекламной оклейке — пример работы Kovtun.studio"
  structuredData={[ldService, ldFaq, ldPortfolioCases]}
>
  <Header nav={nav} phone={site.contact.phone} phoneTel={site.contact.phoneTel} telegramUrl={site.contact.telegram} maxUrl={site.contact.max} />
  <main id="main-content">
    <Hero {...site.hero} />
    <Marquee {...site.marquee} />
    <WhatGrid {...site.whatDo} />
    <Pricing {...site.pricing} tiers={tiers} />
    <section class="section section-tight" id="cases">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2 set:html={site.cases.title}></h2>
          </div>
          <p class="aside">{site.cases.aside}</p>
        </div>

        <div class="pcase-grid pcase-grid--three">
          {wrapCases.map((item, i) => (
            <a class="pcase" href={`/cases/${item.slug}/`}>
              <span class="pcase__media">
                <img
                  src={item.coverSrc}
                  alt={item.coverAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  width="2400"
                  height="1340"
                />
              </span>
              <span class="pcase__body">
                <strong>{item.title}</strong>
                <span class="pcase__meta">{item.meta}</span>
              </span>
              <span class="pcase__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="gallery-more">
          <a class="btn btn-dark btn-lg" href="/portfolio/?direction=wrap">
            {site.cases.ctaAll} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
    <ProcessSteps {...site.process} />
    <FounderSection data={site.founderSection} />
    <FAQ {...site.faqSection} telegramUrl={site.contact.telegram} items={faq} />
    <ContactForm data={site.cta} telegramUrl={site.contact.telegram} telegramHandle={site.contact.telegramHandle} maxUrl={site.contact.max} maxHandle={site.contact.maxHandle} briefUrl="/tools/brief-car-wrap.html" briefLabel="Заполнить бриф на оклейку" goalName="car_wrap_lead_submit" messageIntro="Здравствуйте! Хочу обсудить дизайн оклейки авто." />
  </main>
  <Footer {...footer} />

  <script is:inline>
    (function () {
      "use strict";

      /* Цели Метрики. Отправка формы живет в ContactForm.astro. */
      function goal(name, params) {
        if (typeof window.ksAnalyticsGoal === "function") window.ksAnalyticsGoal(name, params);
      }

      var fields = document.getElementById("form-fields");
      var success = document.getElementById("form-success");
      var fMessage = document.getElementById("f-message");

      /* Tier "Выбрать пакет" -> префилл формы + скролл + цель */
      Array.prototype.forEach.call(document.querySelectorAll(".tier-cta [data-tier]"), function (btn) {
        btn.addEventListener("click", function () {
          if (success && success.hidden === false) { success.hidden = true; fields.hidden = false; }
          if (fMessage) fMessage.value = "Интересует пакет: " + btn.dataset.tier + ".";
          var el = document.getElementById("contact");
          if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
          goal("car_wrap_package_pick", { pkg: btn.dataset.tier || "unknown" });
        });
      });

      /* Цель: телефонный CTA в шапке */
      Array.prototype.forEach.call(document.querySelectorAll('a[href^="tel:"]'), function (link) {
        link.addEventListener("click", function () { goal("cta_phone"); });
      });

      /* Цель: прямые ссылки на Telegram */
      Array.prototype.forEach.call(document.querySelectorAll('a[href^="https://t.me/"]'), function (link) {
        link.addEventListener("click", function () { goal("telegram_direct"); });
      });

      /* Цель: прямые ссылки на MAX */
      Array.prototype.forEach.call(document.querySelectorAll('a[href^="https://max.ru/"]'), function (link) {
        link.addEventListener("click", function () { goal("max_direct"); });
      });

      /* Цель: клик по hero CTA "Обсудить проект" */
      Array.prototype.forEach.call(document.querySelectorAll('a[href="#contact"]'), function (link) {
        link.addEventListener("click", function () { goal("car_wrap_cta_main"); });
      });
    })();
  </script>
</BaseLayout>
