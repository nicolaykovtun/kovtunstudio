  telegramTitle: 'Написать в Telegram',
  maxTitle: 'Написать в MAX',
  formTitle: 'Расскажите о компании',
  fields: {
    name: { label: 'Имя', placeholder: 'Как к вам обращаться', error: 'Как к вам обращаться?' },
    car: {
      label: 'Компания и задача',
      placeholder: 'Например: монтаж отопления, нужен логотип и гайдбук',
      error: 'Сфера и задача — чтобы прикинуть объем',
      msgLabel: 'Компания и задача',
    },
    contact: {
      label: 'Куда ответить',
      placeholder: 'Телефон, почта или ник в Telegram',
      error: 'Куда вам ответить? Телефон, почта или ник.',
    },
    message: {
      label: 'Носители и материалы (необязательно)',
      placeholder: 'Где будет применяться стиль, есть ли текущий логотип и в каком формате',
    },
  },
  privacy: 'Заявка попадает в мою CRM и больше никуда. Как я обращаюсь с данными, написано в политике обработки.',
  submit: 'Отправить заявку',
  successTitle: 'Заявка отправлена',
  successText: 'Отвечу в течение пары часов на контакт из заявки. Если удобнее переписка, ниже готовый текст для Telegram или MAX.',
  successNote: 'В Telegram сообщение подставится само. Для MAX текст скопируется в буфер, вставьте его в чат.',
  errorText: 'Заявка не ушла: сервер не ответил. Напишите мне напрямую, текст заявки уже собран:',
  resetText: 'Отправить еще одну заявку',
};

const footer = {
  ...site.footer,
  columns: [
    {
      title: 'Страница',
      links: [
        { href: '#scope', label: 'Объем' },
        { href: '#pricing', label: 'Цены' },
        { href: '#rules', label: 'Правила' },
        { href: '#cases', label: 'Кейсы' },
        { href: '#process', label: 'Процесс' },
        { href: '#faq', label: 'FAQ' },
      ],
    },
    site.footer.columns[1],
    {
      title: 'Прочее',
      links: [
        { href: '/', label: 'Главная' },
        { href: '/portfolio/', label: 'Портфолио' },
        { href: '/websites/', label: 'Сайты' },
        { href: '/packaging/', label: 'Упаковка' },
        { href: '/presentations/', label: 'Презентации' },
        { href: '/car-wrap/', label: 'Оклейка авто' },
        { href: '/blog/', label: 'Мысли' },
        { href: '#contact', label: 'Оставить заявку' },
      ],
    },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/identity/#service`,
  name: 'Разработка логотипа и фирменного стиля',
  serviceType: 'Фирменный стиль и брендинг',
  description:
    'Логотип во всех исполнениях, гайдбук с охранным полем, палитрой и шрифтами, брендбук на 8–12 носителей. Правила пишутся под тех, кто будет применять стиль: типографию, оклейщика, разработчика сайта.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'Country', name: 'Россия' },
  audience: { '@type': 'BusinessAudience', audienceType: site.business.serviceAudience },
  offers: [
    { '@type': 'Offer', name: 'Логотип', price: '35000', priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Редизайн логотипа', price: '45000', priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Фирменный стиль с гайдбуком', price: '60000', priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Брендбук под ключ', price: '120000', priceCurrency: 'RUB' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const ldPortfolioCases = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${site.url}/identity/#portfolio`,
  name: 'Кейсы фирменного стиля Kovtun.studio',
  url: `${site.url}/identity/`,
  numberOfItems: identityCases.length,
  itemListElement: identityCases.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: item.title,
      url: `${site.url}/cases/${item.slug}/`,
      image: `${site.url}${item.coverSrc}`,
      creator: { '@id': `${site.url}/#business` },
    },
  })),
};
---

<BaseLayout
  title="Логотип и фирменный стиль от 35 000 ₽ · Kovtun.studio"
  description="Логотип от 35 000 ₽, фирменный стиль с гайдбуком 60 000 ₽, брендбук от 120 000 ₽. Правила пишутся под тех, кто применяет стиль без дизайнера."
  keywords="разработка логотипа, фирменный стиль, гайдбук, брендбук, редизайн логотипа, айдентика, брендинг, Владивосток"
  canonicalPath="/identity/"
  ogImage="/og-identity.jpg"
  ogImageAlt="Гайдбук Green Power: знак-дерево на листьях базилика"
  ogTitle="Логотип и фирменный стиль — от знака до брендбука"
  ogDescription="Логотип от 35 000 ₽, гайдбук 60 000 ₽, брендбук от 120 000 ₽. Пять исполнений знака и правила, которые применяют без дизайнера."
  structuredData={[serviceLd, faqLd, ldPortfolioCases]}
>
  <Header nav={nav} phone={site.contact.phone} phoneTel={site.contact.phoneTel} telegramUrl={site.contact.telegram} maxUrl={site.contact.max} />

  <main id="main-content">
    <div class="identity-hero-wrap">
      <Hero {...hero} />
    </div>
    <Marquee {...marquee} />

    <section class="section" id="scope">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2>Три объема —<br>смотря кто применяет стиль</h2>
          </div>
          <p class="aside">Процесс один: бриф, анализ конкурентов, концепции, детализация. Разница в том, сколько правил нужно записать, чтобы стилем пользовались без дизайнера.</p>
        </div>
        <div class="scenario-grid">
          {scenarios.map((scenario) => (
            <article class:list={['scenario-card', { 'is-featured': scenario.featured }]}>
              <div class="scenario-card__top">
                <span class="scenario-num">{scenario.num}</span>
                {scenario.featured && <span class="scenario-badge">Самый частый случай</span>}
              </div>
              <h3>{scenario.title}</h3>
              <p>{scenario.text}</p>
              <a href={`#package-${scenario.num}`}>Смотреть, что входит <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="approach-wrap">
      <WhatGrid {...approach} />
    </div>

    <section class="section presentations-pricing" id="pricing">
      <div class="container-wide">
        <div class="section-head">
          <h2>Четыре формата —<br>от знака до полного регламента</h2>
          <p class="aside">Цена зависит не от размера компании, а от объема задачи: чем больше носителей, правил и документации — тем выше стоимость. Точную смету считаю после брифа.</p>
        </div>

        <article class="audit-card">
          <div class="audit-card__badge">{redesign.badge}</div>
          <div class="audit-card__body">
            <h3>{redesign.title}</h3>
            <p>{redesign.text}</p>
            <ul>
              {redesign.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="audit-card__offer">
            <strong>{redesign.price}</strong>
            <span>{redesign.term}</span>
            <a class="btn btn-primary" href="#contact" data-package="Редизайн логотипа">
              Обсудить редизайн <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <div class="package-grid">
          {packages.map((item) => (
            <article class:list={['package-card', { 'is-featured': item.featured }]} id={`package-${item.num}`}>
              <div class="package-card__head">
                <span>{item.num}</span>
                {item.featured && <b>Чаще всего</b>}
              </div>
              <h3>{item.title}</h3>
              <div class="package-price">{item.price}</div>
              <p class="package-detail">{item.detail}</p>
              <ul>
                {item.items.map((entry) => <li>{entry}</li>)}
              </ul>
              <a class:list={['btn', item.featured ? 'btn-primary' : 'btn-dark']} href="#contact" data-package={item.title}>
                Выбрать формат <span class="arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>

        <p class="rate-note">
          Логотип уже есть? Гайдбук к нему делается отдельно за те же 60 000 ₽ и 10–14 дней —
          нужен исходник в AI или EPS и список носителей.
          Не уверены, какой объем ваш? Пришлите список носителей в
          <a href={site.contact.telegram} target="_blank" rel="noopener">Telegram</a> —
          скажу, что достаточно, и назову вилку. Без обязательств.
        </p>
        <p class="rate-note">
          По готовому стилю дальше собираются <a href="/packaging/">упаковка</a>,
          <a href="/presentations/">презентации</a> и <a href="/car-wrap/">оклейка автопарка</a> —
          включаю их в общую смету проекта, чтобы стиль не пришлось передавать другому исполнителю.
        </p>
      </div>
    </section>

    <section class="section section-tight" id="rules">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2>Что клиент делает<br>по гайдбуку сам</h2>
          </div>
          <p class="aside">
            Три страницы из трех гайдбуков. На каждой одно правило, которое
            исполняют без дизайнера: типография, оклейщик или сам владелец.
          </p>
        </div>

        <div class="rule-grid">
          {rules.map((rule) => (
            <article class="rule-card">
              <figure class="rule-card__media">
                <img
                  src={`${rule.root}/full/${rule.file}.webp`}
                  srcset={`${rule.root}/thumb/${rule.file}-thumbnail.webp 800w, ${rule.root}/full/${rule.file}.webp 1600w`}
                  sizes="(max-width: 900px) 100vw, 33vw"
                  alt={rule.alt}
                  loading="lazy"
                  decoding="async"
                  width="1600"
                  height="900"
                />
              </figure>
              <div class="rule-card__top">
                <span class="rule-num">{rule.num}</span>
                <span class="rule-kicker">{rule.kicker}</span>
              </div>
              <h3>{rule.title}</h3>
              <p>{rule.text}</p>
              <a href={`/cases/${rule.slug}/`}>Смотреть гайдбук в кейсе <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-tight" id="cases">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <h2>Кейсы фирменного<br>стиля</h2>
          </div>
          <p class="aside">
            Каждый проект разобран на отдельной странице: с какими носителями
            пришел клиент, как собран знак и что вошло в гайдбук.
          </p>
        </div>

        <div class="pcase-grid pcase-grid--three">
          {identityCases.map((item, i) => (
            <a class="pcase" href={`/cases/${item.slug}/`}>
              <span class="pcase__media">
                <img
                  src={item.coverSrc}
                  alt={item.coverAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  width="1600"
                  height="900"
                />
              </span>
              <span class="pcase__body">
                <strong>{item.title}</strong>
                <span class="pcase__meta">{item.meta}</span>
              </span>
              <span class="pcase__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="gallery-more">
          <a class="btn btn-dark btn-lg" href="/portfolio/?direction=identity">
            Смотреть все работы по фирменному стилю <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <ReturningClients variant="compact" />

    <ProcessSteps {...process} />

    <FounderSection data={identityFounder} />

    <FAQ
      title="Частые<br>вопросы"
      intro="Если короткого ответа недостаточно — напишите в Telegram. Посмотрю текущий знак и отвечу по вашей задаче."
      ctaAsk="Задать вопрос"
      telegramUrl={site.contact.telegram}
      items={faqItems.map((item) => ({ q: item.q, a: item.aHtml ?? item.a }))}
    />

    <ContactForm
      data={contactData}
      telegramUrl={site.contact.telegram}
      telegramHandle={site.contact.telegramHandle}
      maxUrl={site.contact.max}
      maxHandle={site.contact.maxHandle}
      briefUrl="/tools/brief-identity.html"
      briefLabel="Заполнить бриф на фирменный стиль"
      goalName="identity_lead_submit"
      messageIntro="Здравствуйте! Хочу обсудить логотип и фирменный стиль."
    />
  </main>

  <Footer {...footer} />

  <script is:inline>
    (function () {
      'use strict';

      /* Цели Метрики. Отправка формы живет в ContactForm.astro. */
      function goal(name, params) {
        if (typeof window.ksAnalyticsGoal === 'function') window.ksAnalyticsGoal(name, params);
      }

      var form = document.getElementById('lead-form');
      var fields = document.getElementById('form-fields');
      var success = document.getElementById('form-success');
      var fMessage = document.getElementById('f-message');

      /* Кнопки форматов: префилл формы + скролл + цель */
      Array.prototype.forEach.call(document.querySelectorAll('[data-package]'), function (btn) {
        btn.addEventListener('click', function () {
          if (success && success.hidden === false) { success.hidden = true; fields.hidden = false; form.classList.remove('is-success'); }
          if (fMessage) fMessage.value = 'Интересует формат: ' + btn.dataset.package + '.';
          goal('identity_package_pick', { pkg: btn.dataset.package });
        });
      });

      Array.prototype.forEach.call(document.querySelectorAll('a[href="#contact"]'), function (link) {
        link.addEventListener('click', function () { goal('identity_cta_main'); });
      });

      Array.prototype.forEach.call(document.querySelectorAll('a[href^="https://t.me/"]'), function (link) {
        link.addEventListener('click', function () { goal('telegram_direct'); });
      });

      Array.prototype.forEach.call(document.querySelectorAll('a[href^="tel:"]'), function (link) {
        link.addEventListener('click', function () { goal('cta_phone'); });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* В сценариях этой страницы нет строки с ценой, поэтому к нижнему краю
     карточки прижимается сама ссылка (как на /packaging/). */
  .scenario-card a {
    margin-top: auto;
  }

  /* Водяной знак hero: слово читает .hero-red::after в global.css. */
  .identity-hero-wrap :global(.hero-red) {
    --hero-watermark: 'ЗНАК';
  }

  /* В блоке «Четыре вопроса» карточек четыре: в базовой сетке из трех колонок
     четвертая повисала одна в ряду, поэтому здесь 2×2. */
  @media (min-width: 801px) {
    .approach-wrap :global(.what-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Карточки правил. От scenario-card отличаются тем, что несут ссылку
     на конкретный кейс: правило должно быть проверяемым. */
  .rule-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .rule-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 26px;
    background: var(--bg-2);
    border-top: 3px solid var(--ks-red);
  }

  /* Страница гайдбука во всю ширину карточки, встык к красной линии сверху. */
  .rule-card__media {
    margin: -28px -26px 16px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-3, var(--bg-2));
  }

  .rule-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rule-card__top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rule-num {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .14em;
    color: var(--ks-red);
  }

  .rule-kicker {
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .rule-card h3 {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
  }

  .rule-card p {
    margin: 0;
    color: var(--fg-3);
    font-size: 15px;
    line-height: 1.55;
  }

  .rule-card a {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .rule-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
