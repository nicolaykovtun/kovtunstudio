import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { caseOrderIndex, directionByCategory } from '../data/case-catalog';
import { servicePageNav } from '../lib/site-nav';
import '../styles/presentations.css';

const dataDir = path.resolve('./src/data');
const site = yaml.load(fs.readFileSync(path.join(dataDir, 'site.yaml'), 'utf8')) as any;

// Локальная навигация страницы — как у /packaging/, /presentations/ и /car-wrap/.
const nav = servicePageNav(site, [
  { href: '#scope', label: 'Объем' },
  { href: '#pricing', label: 'Цены' },
  { href: '#rules', label: 'Правила' },
  { href: '#cases', label: 'Работы' },
  { href: '#faq', label: 'FAQ' },
]);

// Кейсы направления «Логотип и фирменный стиль» — из общей коллекции,
// в каноническом порядке каталога. Строка объема на карточке задана
// вручную: в шапке кейса этих цифр нет.
const caseMetaBySlug: Record<string, string> = {
  'identity-green-power': '5 исполнений · гайдбук 8 страниц',
  'identity-trubovarnya': '5 исполнений · 9 запретов в правилах',
  'identity-sila-car': '5 исполнений · баннер 3000×1500 мм',
};

const identityCases = (await getCollection('cases', ({ data }) => !data.draft))
  .filter((entry) => directionByCategory[entry.data.category] === 'identity')
  .filter((entry) => Boolean(entry.data.gallery))
  .sort((a, b) => caseOrderIndex(a.id) - caseOrderIndex(b.id))
  .map((entry) => {
    const c = entry.data;
    return {
      slug: c.slug,
      title: c.shortTitle || c.client,
      meta: [caseMetaBySlug[c.slug], c.segmentLabel].filter(Boolean).join(' · '),
      coverSrc: `${c.gallery.assetRoot}/${c.gallery.cover.src}`,
      coverAlt: c.gallery.cover.alt,
    };
  });

// Счетчик в hero считается по кейсам, а не пишется руками: после публикации
// нового кейса цифра меняется сама.
const plural = (n: number, one: string, few: string, many: string) => {
  const mod100 = n % 100;
  const mod10 = n % 10;
  if (mod100 >= 11 && mod100 <= 14) return many;
  if (mod10 === 1) return one;
  if (mod10 >= 2 && mod10 <= 4) return few;
  return many;
};

