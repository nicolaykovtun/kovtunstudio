---
/**
 * Клиенты, которые вернулись за следующим проектом.
 *
 * Вместо отзывов, которых у студии нет, показываем цепочки заказов одного
 * клиента: стиль → этикетки → сайт → оклейка. Все считается из кейсов —
 * редакционных (cases/) и архивных (cases.yaml) — по имени клиента, поэтому
 * после публикации нового кейса цепочка достраивается сама. Никаких цифр
 * руками: заголовок, подпись и порядок шагов выводятся из данных.
 */
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import { getCollection } from 'astro:content';
import { caseOrderIndex } from '../data/case-catalog';
import { editorialCaseConfigs } from '../data/case-page-config';
import { caseCoverBySlug } from '../lib/case-covers';

interface Props {
  /** full — блок с заголовком-тезисом для главной; compact — полоса под ценами на странице услуги. */
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;

// Подпись шага в цепочке. Базово это короткое название кейса без имени клиента:
// оно уже стоит в заголовке цепочки. Карта ниже — только ручные сокращения там,
// где так читается лучше; для нового кейса заполнять ее не обязательно.
//
// Голый categoryLabel в подписи не годится: у МСМ ГРУПП три кейса, из них два
// по упаковке, и цепочка читалась «Упаковка → Фирменный стиль → Упаковка».
const stepLabelBySlug: Record<string, string> = {
  'identity-green-power': 'Фирменный стиль',
  'labels-green-power-oil': 'Этикетки масла',
  'labels-green-power-juice': 'Этикетки соков',
  'labels-green-power-paste': 'Этикетки пасты',
  'website-green-power': 'Сайт',
  'green-power': 'Оклейка автопарка',
  'identity-trubovarnya': 'Фирменный стиль',
  'website-trubovarnya': 'Сайт',
  'identity-sila-car': 'Фирменный стиль',
  'sila-car': 'Оклейка авто',
};

type Step = { slug: string; label: string; title: string; year?: number; order: number };

const normalize = (name: string) => name.replace(/[«»"]/g, '').trim().toLowerCase();

/**
 * «Этикетки масла Green Power» + клиент «Green Power» → «Этикетки масла».
 * Имя клиента вырезается поиском по подстроке, без конструирования регулярки:
 * в именах встречаются кавычки и точки, и экранировать их незачем.
 * Если имени в названии нет (у МСМ ГРУПП кейсы называются по брендам —
 * MICKING и Alaska), название остается как есть.
 */
const stripClient = (title: string, client: string) => {
  const name = client.replace(/[«»"]/g, '').trim();
  if (!name) return title;
  const at = title.toLowerCase().indexOf(name.toLowerCase());
  if (at < 0) return title;
  const stripped = `${title.slice(0, at)} ${title.slice(at + name.length)}`
    .replace(/\s+/g, ' ')
    .trim();
  return stripped.length >= 3 ? stripped : title;
};

const dataDir = path.resolve('./src/data');
const legacyCases = yaml.load(fs.readFileSync(path.join(dataDir, 'cases.yaml'), 'utf8')) as any[];
const editorialEntries = (await getCollection('cases', ({ data }) => !data.draft))
  .filter((entry) => Boolean(entry.data.gallery) || Boolean(editorialCaseConfigs[entry.id]));

const byClient = new Map<string, { client: string; steps: Step[] }>();
const push = (client: string, step: Step) => {
  const key = normalize(client);
  if (!byClient.has(key)) byClient.set(key, { client, steps: [] });
  byClient.get(key)!.steps.push(step);
};

for (const entry of editorialEntries) {
  const c = entry.data;
  const title = c.shortTitle || c.client;
  push(c.client, {
    slug: c.slug,
    label: stepLabelBySlug[c.slug] ?? stripClient(title, c.client),
    title,
    year: c.year ? Number(c.year) : undefined,
    order: caseOrderIndex(c.slug),
  });
}
for (const c of legacyCases) {
  push(c.name, {
    slug: c.slug,
    label: stepLabelBySlug[c.slug] ?? stripClient(c.title || c.name, c.name),
    title: c.title || c.name,
    year: c.year ? Number(c.year) : undefined,
    order: caseOrderIndex(c.slug),
  });
}

const totalCases = editorialEntries.length + legacyCases.length;

const chains = [...byClient.values()]
  .filter((chain) => chain.steps.length >= 2)
  .map((chain) => ({
    ...chain,
    steps: chain.steps.sort((a, b) => (a.year ?? 9999) - (b.year ?? 9999) || a.order - b.order),
  }))
  .sort((a, b) => b.steps.length - a.steps.length);

// Страховка от одинаковых подписей внутри одной цепочки: если два шага назвались
// так же, оба показываются полным названием кейса. Без нее новый кейс молча
// ломает читаемость блока, а заметить это можно только глазами на главной.
for (const chain of chains) {
  const seen = new Map<string, number>();
  for (const step of chain.steps) seen.set(step.label, (seen.get(step.label) ?? 0) + 1);
  for (const step of chain.steps) {
    if ((seen.get(step.label) ?? 0) > 1) step.label = step.title;
  }
}

const returningCases = chains.reduce((sum, chain) => sum + chain.steps.length, 0);

const plural = (n: number, one: string, few: string, many: string) => {
  const mod100 = n % 100;
  const mod10 = n % 10;
  if (mod100 >= 11 && mod100 <= 14) return many;
  if (mod10 === 1) return one;
  if (mod10 >= 2 && mod10 <= 4) return few;
  return many;
};
const numeral = ['ноль', 'один', 'два', 'три', 'четыре', 'пять', 'шесть', 'семь', 'восемь', 'девять', 'десять'];
const ordinal = ['', '', 'второй', 'третий', 'четвертый', 'пятый', 'шестой'];

// Превью под курсором: шаг цепочки — это кейс, показываем его обложку.
const coverBySlug = await caseCoverBySlug();

const top = chains[0];
const topCount = top?.steps.length ?? 0;
const topWord = numeral[topCount] ?? String(topCount);
const title = top
  ? `${topWord[0].toUpperCase()}${topWord.slice(1)} ${plural(topCount, 'проект', 'проекта', 'проектов')}<br>для одного клиента`
  : '';

const ratio = returningCases ? Math.round(totalCases / returningCases) : 0;
const aside =
  ratio >= 2 && ratio <= 6
    ? `Каждый ${ordinal[ratio]} кейс в портфолио — следующий проект для прежнего клиента. Логотип заказали первым, потом доверили этикетки, сайт и машины.`
    : `${returningCases} из ${totalCases} кейсов в портфолио — следующие проекты для прежних клиентов.`;

const yearsOf = (steps: Step[]) => {
  const years = steps.map((s) => s.year).filter((y): y is number => Boolean(y));
  if (!years.length) return '';
  const min = Math.min(...years);
  const max = Math.max(...years);
  return min === max ? String(min) : `${min}–${max}`;
};
---
{chains.length > 0 && (
  <section class:list={['section', 'returning', { 'returning--compact': variant === 'compact' }]} id="returning">
    <div class="container-wide">
      <div class="section-head">
        <div>
          <h2 set:html={title}></h2>
        </div>
        <p class="aside">{aside}</p>
      </div>

      <div class="chains">
        {chains.map((chain, index) => (
          <article class:list={['chain', { 'chain--lead': index === 0 }]}>
            <header class="chain__head">
              <strong>{chain.client}</strong>
              <span>{`${chain.steps.length} ${plural(chain.steps.length, 'проект', 'проекта', 'проектов')}${yearsOf(chain.steps) ? ` · ${yearsOf(chain.steps)}` : ''}`}</span>
            </header>
            <ol class="chain__steps">
              {chain.steps.map((step) => (
                <li>
                  <a
                    href={`/cases/${step.slug}/`}
                    data-preview-src={coverBySlug[step.slug]?.src}
                    data-preview-alt={coverBySlug[step.slug]?.alt}
                  >
                    <span class="chain__label">{step.label}</span>
                    {step.year && <small>{step.year}</small>}
                  </a>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<script is:inline>
  (function () {
    'use strict';
    var lists = document.querySelectorAll('.chain__steps');
    if (!lists.length) return;

    function mark(list) {
      var items = list.children;
      for (var i = 0; i < items.length; i++) {
        var next = items[i + 1];
        items[i].classList.toggle('is-wrap', !!next && next.offsetTop > items[i].offsetTop);
      }
    }
    function markAll() {
      Array.prototype.forEach.call(lists, mark);
    }

    markAll();
    /* Пересчет на смене ширины и после загрузки Geist: подписи меряются
       шрифтом, и до его подмены строки рвутся в других местах. */
    if ('ResizeObserver' in window) {
      var ro = new ResizeObserver(markAll);
      Array.prototype.forEach.call(lists, function (list) { ro.observe(list); });
    } else {
      window.addEventListener('resize', markAll);
    }
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(markAll);
  })();
</script>

<style>
  .chains {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .chain {
    padding: 26px 26px 22px;
    background: var(--bg-2);
    border-top: 3px solid var(--line-2);
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out),
      border-color var(--dur-base);
  }
  .chain:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-2);
    border-top-color: var(--ks-red);
  }
  .chain--lead {
    grid-column: 1 / -1;
    border-top-color: var(--ks-red);
  }
  .chain__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
    margin-bottom: 18px;
  }
  .chain__head strong {
    font: 700 22px/1.2 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--fg-1);
  }
  .chain--lead .chain__head strong { font-size: 26px; }
  .chain__head span {
    font: 600 12px/1.4 var(--font-mono);
    letter-spacing: .05em;
    color: var(--fg-3);
    white-space: nowrap;
  }

  /* Шаги цепочки: стрелка между пунктами — сама история заказов. Стоит она
     после шага, а не перед следующим: ведущая стрелка на переносе сдвигала
     первый шаг новой строки на 40px вправо, и левый край списка получался
     рваным — у Green Power и МСМ ГРУПП это видно сразу. */
  .chain__steps {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 2px 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .chain__steps li { display: flex; align-items: center; }
  .chain__steps li:not(:last-child)::after {
    content: '→';
    margin: 0 12px;
    color: var(--ks-red);
    font: 400 20px/1 var(--font-display);
  }
  /* Последний шаг в строке: следующий уехал на строку ниже, и стрелка вправо
     показывала бы в пустоту. Класс ставит скрипт ниже — в CSS перенос строки
     не виден. Без скрипта остается обычная стрелка вправо. */
  .chain__steps li.is-wrap::after { content: '↓'; }
  /* Линия под шагом снята: на сайте ссылки не подчеркиваются, роль ссылки
     держат вес 600 и красный на наведении. Вместо линии шаг чуть приподнимается
     — движение то же, что у строк списков. */
  .chain__steps a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-height: 44px;
    /* Паддингом, а не min-height: при baseline-выравнивании текст прижимался
       к верху 44-пиксельной ссылки, и стрелка рядом оказывалась на 12px ниже
       подписи. Теперь высота набирается паддингом, текст стоит по центру
       строки и стрелка совпадает с ним. */
    padding: 12px 2px;
    text-decoration: none;
    color: var(--fg-1);
    font: 600 15px/1.3 var(--font-display);
    transition: color var(--dur-base), transform var(--dur-base) var(--ease-out);
  }
  .chain__steps a:hover { color: var(--ks-red); transform: translateY(-2px); }
  .chain__steps small {
    font: 500 12px/1 var(--font-mono);
    color: var(--fg-3);
    transition: color var(--dur-base);
  }
  .chain__steps a:hover small { color: var(--ks-red); }

  /* Компактный вариант на странице услуги: та же раскладка, меньше воздуха.
     Ведущая цепочка из шести шагов в узкой колонке ломалась на три строки,
     поэтому и здесь она во всю ширину. */
  .returning--compact .chain { padding: 22px 22px 18px; }
  .returning--compact .chain__head strong,
  .returning--compact .chain--lead .chain__head strong { font-size: 20px; }
  .returning--compact .chain__steps a { font-size: 14px; }

  @media (prefers-reduced-motion: reduce) {
    .chain,
    .chain__steps a { transition: none; }
    .chain:hover,
    .chain__steps a:hover { transform: none; }
  }

  @media (max-width: 900px) {
    .chains,
    .returning--compact .chains { grid-template-columns: 1fr; }
    .chain__steps li:not(:last-child)::after { margin: 0 10px; }
  }
</style>
