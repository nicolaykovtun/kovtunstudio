---
import site from '../lib/site';

interface Props {
  data: {
    title: string;
    intro: string;
    telegramTitle: string;
    maxTitle: string;
    formTitle: string;
    fields: {
      name: { label: string; placeholder: string; error?: string };
      car: { label: string; placeholder: string; error?: string; msgLabel?: string };
      contact: { label: string; placeholder: string; error?: string };
      message: { label: string; placeholder: string };
    };
    privacy: string;
    submit: string;
    successTitle: string;
    successText: string;
    successNote: string;
    errorText: string;
    resetText: string;
  };
  telegramUrl: string;
  telegramHandle: string;
  maxUrl: string;
  maxHandle: string;
  /* Ссылка на бриф направления. Не задана — блок с брифом не рисуется. */
  briefUrl?: string;
  briefLabel?: string;
  /* Цель Метрики при успешной отправке, у каждой страницы своя. */
  goalName?: string;
  /* Первая строка текста для Telegram и MAX, у каждой страницы своя. */
  messageIntro?: string;
}
const {
  data, telegramUrl, maxUrl, briefUrl, briefLabel,
  goalName = 'lead_submit',
  messageIntro = 'Здравствуйте! Хочу обсудить проект дизайна.',
} = Astro.props;
const consentMarker = `Согласие на обработку персональных данных: да · редакция ${site.legal.policyVersion} от ${site.legal.policyDate} · ${site.url}/consent/`;
---
<section class="cta-section" id="contact">
  <div class="container-wide">
    <div class="cta-wrap">
      <div class="pitch">
        <h2 style="margin-top:0">{data.title}</h2>
        <p>{data.intro}</p>

        <div class="messenger-links">
          <a href={telegramUrl} target="_blank" rel="noopener" class="telegram-direct">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.5 4.2 2.6 11.5c-1.3.5-1.3 1.2-.2 1.5l4.8 1.5 11.1-7c.5-.3 1 .1.6.4l-9 8.1-.3 4.7c.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.6.2 1.9-.9l3.3-15.6c.4-1.4-.5-2-1.7-1.5z"/>
            </svg>
            {data.telegramTitle}
          </a>

          <a href={maxUrl} target="_blank" rel="noopener" class="telegram-direct max-direct">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            {data.maxTitle}
          </a>

          {briefUrl && (
            <a href={briefUrl} class="telegram-direct brief-direct" data-brief-link>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/>
              </svg>
              {briefLabel || 'Заполнить бриф'}
            </a>
          )}
        </div>

        {briefUrl && (
          <p class="brief-note">Десять минут вопросов — и у задачи появляется точное описание.
          Бриф можно отправить прямо со страницы или сохранить в PDF и унести к любому подрядчику.</p>
        )}
      </div>

      <form class="k-form ym-hide-content" id="lead-form" data-legal-consent novalidate>
        <div id="form-fields">
          <div class="form-head">
            <span class="overline">Заявка</span>
            <h3>{data.formTitle}</h3>
          </div>
          <div class="field-row">
            <div class="field">
              <input type="text" id="f-name" placeholder={data.fields.name.placeholder} autocomplete="name"
                data-error={data.fields.name.error || 'Как к вам обращаться?'}>
              <label class="lbl" for="f-name">{data.fields.name.label}</label>
              <span class="field-error" id="err-name" hidden></span>
            </div>
            <div class="field">
              <input type="text" id="f-car" placeholder={data.fields.car.placeholder}
                data-error={data.fields.car.error || 'Опишите задачу парой слов'}
                data-msg-label={data.fields.car.msgLabel || data.fields.car.label}>
              <label class="lbl" for="f-car">{data.fields.car.label}</label>
              <span class="field-error" id="err-car" hidden></span>
            </div>
          </div>
          <div class="field">
            <input type="text" id="f-contact" placeholder={data.fields.contact.placeholder} autocomplete="tel email"
              data-error={data.fields.contact.error || 'Куда вам ответить? Телефон, почта или ник.'}>
            <label class="lbl" for="f-contact">{data.fields.contact.label}</label>
            <span class="field-error" id="err-contact" hidden></span>
          </div>
          <div class="field">
            <textarea id="f-message" class="ym-disable-keys" placeholder={data.fields.message.placeholder} rows="3"></textarea>
            <label class="lbl" for="f-message">{data.fields.message.label}</label>
          </div>

          <div class="lead-honeypot" aria-hidden="true">
            <label for="f-website">Ваш сайт</label>
            <input type="text" id="f-website" data-lead-hp tabindex="-1" autocomplete="off">
          </div>

          <div class="legal-consent">
            <input type="checkbox" id="f-consent" data-consent-checkbox>
            <label for="f-consent">
              Я даю <a href="/consent/" target="_blank">согласие на обработку персональных данных</a>
              и ознакомился с <a href="/privacy/" target="_blank">политикой обработки</a>.
            </label>
          </div>
          <span class="field-error consent-error" data-consent-error hidden>
            Подтвердите согласие, чтобы отправить заявку
          </span>

          <button type="submit" class="btn btn-primary btn-send">
            {data.submit} <span class="arrow" aria-hidden="true">→</span>
          </button>

          <!-- Ошибка отправки: заявка не дошла, предлагаем мессенджеры с готовым текстом -->
          <div class="form-error" id="form-error" hidden>
            {data.errorText}
            <a id="error-telegram" href={telegramUrl} target="_blank" rel="noopener">{data.telegramTitle}</a>
            <span aria-hidden="true">·</span>
            <a id="error-max" href={maxUrl} target="_blank" rel="noopener" data-max-copy>{data.maxTitle}</a>
          </div>

          <!-- Privacy текст под кнопками. Внутри есть ссылка на /consent/,
               поэтому строка выводится как разметка, а не как текст. -->
          <div class="privacy" set:html={data.privacy}></div>
        </div>

        <!-- Успешная отправка -->
        <div id="form-success" hidden>
          <div class="success-head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
            <h3 id="success-title">{data.successTitle}</h3>
          </div>
          <p id="success-text">{data.successText}</p>

          <div class="success-links">
            <a href={telegramUrl} id="success-telegram" target="_blank" rel="noopener" class="btn btn-white">
              {data.telegramTitle} <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href={maxUrl} id="success-max" target="_blank" rel="noopener" class="btn btn-white" data-max-copy>
              {data.maxTitle} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <p class="success-note">{data.successNote}</p>
          <button type="button" id="form-reset">
            {data.resetText}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  /* Ссылки на мессенджеры и бриф в pitch-блоке, с заметным отступом */
  .messenger-links {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 32px;
  }
  .max-direct { margin-top: 0; }  /* отступ задается через gap у .messenger-links */
  .brief-direct { margin-top: 0; }

  /* Пояснение под ссылкой на бриф: без него кнопка читается как еще одна форма заявки */
  .brief-note {
    margin: 14px 0 0;
    font: 400 13px/1.6 var(--font-body);
    color: var(--fg-3);
    max-width: 46ch;
  }

  /* Privacy текст под кнопками */
  #form-fields .privacy {
    margin-top: 0;
    font: 400 12px/1.5 var(--font-body);
    color: var(--fg-3);
  }
  #form-fields .privacy a {
    color: inherit;
    text-underline-offset: 3px;
  }

  /* Ошибка отправки — заметная строка под кнопкой */
  .form-error {
    font: 400 14px/1.5 var(--font-body);
    color: var(--fg-1);
    background: rgba(0, 0, 0, .14);
    border: 1px solid rgba(255, 255, 255, .35);
    padding: 12px 14px;
  }
  .form-error a {
    color: inherit;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  /* Две кнопки мессенджеров на экране успеха */
  .success-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .success-note {
    margin: 10px 0 0;
    font: 400 13px/1.5 var(--font-body);
    color: var(--fg-3);
  }

  .legal-consent {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
  }
  .legal-consent input {
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--ks-red);
  }
  .legal-consent label {
    color: var(--fg-2);
    font: 400 14px/1.45 var(--font-body);
  }
  .legal-consent a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .consent-error { margin-top: -8px; }
  .lead-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script is:inline define:vars={{
  TELEGRAM_URL: telegramUrl,
  CONSENT_MARKER: consentMarker,
  GOAL_NAME: goalName,
  MSG_INTRO: messageIntro,
}}>
  (function () {
    'use strict';

    function goal(name, params) {
      if (typeof window.ksAnalyticsGoal === 'function') window.ksAnalyticsGoal(name, params);
    }

    /* Открытие брифа — отдельная цель: по ней видно, работает ли вторая кнопка. */
    var briefLink = document.querySelector('[data-brief-link]');
    if (briefLink) {
      briefLink.addEventListener('click', function () {
        goal('brief_open', { href: briefLink.getAttribute('href') || '' });
      });
    }

    var form = document.getElementById('lead-form');
    if (!form) return;

    var fName = document.getElementById('f-name');
    var fTask = document.getElementById('f-car');
    var fContact = document.getElementById('f-contact');
    var fMessage = document.getElementById('f-message');
    var errName = document.getElementById('err-name');
    var errTask = document.getElementById('err-car');
    var errContact = document.getElementById('err-contact');
    var fields = document.getElementById('form-fields');
    var success = document.getElementById('form-success');
    var successTg = document.getElementById('success-telegram');
    var errorTg = document.getElementById('error-telegram');
    var formError = document.getElementById('form-error');
    var submitBtn = form.querySelector('.btn-send');
    var submitHtml = submitBtn ? submitBtn.innerHTML : '';

    function setError(node, message) {
      if (!node) return;
      node.textContent = message || '';
      node.hidden = !message;
    }

    function check(input, errNode) {
      if (!input.value.trim()) { setError(errNode, input.dataset.error); return false; }
      setError(errNode, '');
      return true;
    }

    function validate() {
      var a = check(fName, errName);
      var b = check(fTask, errTask);
      var c = check(fContact, errContact);
      return a && b && c;
    }

    /* Текст для мессенджера: тот же состав, что ушел в CRM, плюс номер заявки. */
    function messengerText(dealNo) {
      var lines = [MSG_INTRO, ''];
      if (fName.value.trim()) lines.push('Имя: ' + fName.value.trim());
      if (fTask.value.trim()) lines.push((fTask.dataset.msgLabel || 'Задача') + ': ' + fTask.value.trim());
      if (fMessage.value.trim()) lines.push('\nДетали:\n' + fMessage.value.trim());
      if (dealNo) lines.push('\nЗаявка с сайта №' + dealNo);
      lines.push('\n' + CONSENT_MARKER);
      return lines.join('\n');
    }

    /* MAX не подставляет текст из ссылки, поэтому кладем его в буфер обмена. */
    var lastText = '';
    Array.prototype.forEach.call(document.querySelectorAll('[data-max-copy]'), function (link) {
      link.addEventListener('click', function () {
        var text = lastText || messengerText('');
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).catch(function () {});
        }
        goal(GOAL_NAME.replace(/_submit$/, '_max'), { page: window.location.pathname });
      });
    });

    var sending = false;
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (sending || !validate()) return;

      formError.hidden = true;
      sending = true;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Отправляю…'; }

      var finish = function (result) {
        sending = false;
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = submitHtml; }
        if (result && result.ok) {
          lastText = messengerText(result.deal || result.lead || '');
          if (successTg) successTg.href = TELEGRAM_URL + '?text=' + encodeURIComponent(lastText);
          fields.hidden = true;
          success.hidden = false;
          form.classList.add('is-success');
          goal(GOAL_NAME, { page: window.location.pathname });
        } else {
          lastText = messengerText('');
          if (errorTg) errorTg.href = TELEGRAM_URL + '?text=' + encodeURIComponent(lastText);
          formError.hidden = false;
          goal('lead_send_error', { page: window.location.pathname });
        }
      };

      if (typeof window.kovtunLeadSubmit === 'function') {
        window.kovtunLeadSubmit({
          name: fName.value.trim(),
          contact: fContact.value.trim(),
          message: fTask.value.trim() + (fMessage.value.trim() ? '\n\n' + fMessage.value.trim() : ''),
          consent: CONSENT_MARKER,
        }).then(finish);
      } else {
        finish({ ok: false });
      }
    });

    var resetBtn = document.getElementById('form-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        form.reset();
        setError(errName, '');
        setError(errTask, '');
        setError(errContact, '');
        formError.hidden = true;
        success.hidden = true;
        fields.hidden = false;
        form.classList.remove('is-success');
      });
    }
  })();
</script>
