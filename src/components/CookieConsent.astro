---
interface Props {
  metrikaId: number;
  metrikaOptions: Record<string, unknown>;
}

const { metrikaId, metrikaOptions } = Astro.props;
---

<aside class="cookie-consent" id="cookie-consent" aria-labelledby="cookie-consent-title" hidden>
  <div class="cookie-consent__copy">
    <strong id="cookie-consent-title">Можно включить полную аналитику?</strong>
    <p>
      Сейчас Яндекс Метрика считает просмотры обезличенно: без cookies и без записи действий.
      С вашего разрешения добавятся cookies и Вебвизор — так видно, что на сайте работает плохо.
      Откажетесь — сайт продолжит работать как обычно.
      <a href="/cookies/">Подробнее о cookies</a>
    </p>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" class="cookie-consent__button cookie-consent__button--secondary" data-cookie-choice="denied">
      Только необходимые
    </button>
    <button type="button" class="cookie-consent__button cookie-consent__button--primary" data-cookie-choice="granted">
      Разрешить аналитику
    </button>
  </div>
</aside>

<button
  type="button"
  class="cookie-settings-button"
  id="cookie-settings-button"
  aria-label="Изменить настройки cookies"
  title="Настройки cookies"
  hidden
>
  Cookies
</button>

<script is:inline define:vars={{ METRIKA_ID: metrikaId, METRIKA_OPTIONS: metrikaOptions }}>
  (function () {
    'use strict';

    var STORAGE_KEY = 'ks_analytics_consent';
    var CONSENT_VERSION = '1';
    var banner = document.getElementById('cookie-consent');
    var settingsButton = document.getElementById('cookie-settings-button');

    // Режим до согласия: счетчик работает, но без cookies и без Вебвизора.
    // Так код Метрики всегда есть в DOM — робот Яндекса видит его и может
    // использовать обход страниц по счетчику в Вебмастере.
    var ANON_OPTIONS = Object.assign({}, METRIKA_OPTIONS, {
      withoutCookies: true,
      webvisor: false
    });

    var tagRequested = false;
    var initMode = null; // null | 'anon' | 'full'

    function readChoice() {
      try {
        var stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        if (!stored || stored.version !== CONSENT_VERSION) return null;
        return stored.choice === 'granted' || stored.choice === 'denied' ? stored.choice : null;
      } catch (error) {
        return null;
      }
    }

    function saveChoice(choice) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          choice: choice,
          version: CONSENT_VERSION,
          updatedAt: new Date().toISOString()
        }));
      } catch (error) {}
    }

    function deleteMetrikaCookies() {
      [
        '_ym_d',
        '_ym_isad',
        '_ym_uid',
        '_ym_visorc',
        '_ym_wv2rf',
        '_ym_metrika_enabled',
        '_ym_fa'
      ].forEach(function (name) {
        document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax';
        document.cookie = name + '=; Max-Age=0; path=/; domain=.' + location.hostname + '; SameSite=Lax';
      });
    }

    function ensureTag() {
      if (tagRequested) return;
      tagRequested = true;
      window.ym = window.ym || function () {
        (window.ym.a = window.ym.a || []).push(arguments);
      };
      window.ym.l = 1 * new Date();

      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://mc.yandex.ru/metrika/tag.js?id=' + METRIKA_ID;
      document.head.appendChild(script);
    }

    // Обезличенный режим: хит уходит, cookies не пишутся, Вебвизор выключен.
    function loadMetrikaAnonymous() {
      if (initMode) return;
      initMode = 'anon';
      window['disableYaCounter' + METRIKA_ID] = false;
      ensureTag();
      window.ym(METRIKA_ID, 'init', ANON_OPTIONS);
    }

    // Полный режим: cookies, Вебвизор, склейка визитов одного посетителя.
    function loadMetrikaFull() {
      if (initMode === 'full') return;
      window['disableYaCounter' + METRIKA_ID] = false;
      ensureTag();
      window.ym(METRIKA_ID, 'init', METRIKA_OPTIONS);
      // Если счетчик уже был поднят обезличенно, Метрика игнорирует повторный
      // init в этой загрузке страницы: полный режим включится со следующей.
      initMode = 'full';
    }

    function disableMetrika() {
      window['disableYaCounter' + METRIKA_ID] = true;
      deleteMetrikaCookies();
    }

    function showBanner() {
      if (!banner) return;
      banner.hidden = false;
      if (settingsButton) settingsButton.hidden = true;
    }

    function hideBanner() {
      if (banner) banner.hidden = true;
      if (settingsButton) settingsButton.hidden = false;
    }

    function applyChoice(choice) {
      saveChoice(choice);
      if (choice === 'granted') loadMetrikaFull();
      else disableMetrika();
      hideBanner();
      document.dispatchEvent(new CustomEvent('ks:analytics-consent', { detail: { choice: choice } }));
    }

    var choice = readChoice();
    if (choice === 'granted') {
      loadMetrikaFull();
      hideBanner();
    } else if (choice === 'denied') {
      disableMetrika();
      hideBanner();
    } else {
      loadMetrikaAnonymous();
      showBanner();
    }

    document.querySelectorAll('[data-cookie-choice]').forEach(function (button) {
      button.addEventListener('click', function () {
        applyChoice(button.getAttribute('data-cookie-choice'));
      });
    });

    function reopenSettings(event) {
      if (event) event.preventDefault();
      showBanner();
      if (banner) banner.querySelector('button')?.focus();
    }

    if (settingsButton) settingsButton.addEventListener('click', reopenSettings);
    document.querySelectorAll('a[href="#cookie-settings"]').forEach(function (link) {
      link.addEventListener('click', reopenSettings);
    });
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 200;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    left: max(16px, env(safe-area-inset-left));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px 24px;
    color: #fff;
    background: var(--ks-charcoal);
    border: 1px solid rgba(255,255,255,.16);
    box-shadow: 0 20px 60px rgba(0,0,0,.3);
  }
  .cookie-consent[hidden] { display: none; }
  .cookie-consent__copy strong {
    display: block;
    margin-bottom: 6px;
    font: 700 17px/1.25 var(--font-display);
  }
  .cookie-consent__copy p {
    max-width: 72ch;
    margin: 0;
    color: rgba(255,255,255,.76);
    font: 400 14px/1.5 var(--font-body);
  }
  .cookie-consent__copy a { color: #fff; text-underline-offset: 3px; }
  .cookie-consent__actions { display: flex; gap: 10px; }
  .cookie-consent__button {
    min-height: 48px;
    padding: 12px 16px;
    border: 1px solid rgba(255,255,255,.3);
    color: #fff;
    font: 650 14px/1.2 var(--font-body);
    cursor: pointer;
  }
  .cookie-consent__button--secondary { background: transparent; }
  .cookie-consent__button--primary {
    border-color: var(--ks-red);
    background: var(--ks-red);
  }
  .cookie-consent__button:hover,
  .cookie-consent__button:focus-visible { border-color: #fff; outline: none; }
  .cookie-settings-button {
    position: fixed;
    z-index: 120;
    right: max(12px, env(safe-area-inset-right));
    bottom: max(12px, env(safe-area-inset-bottom));
    min-width: 48px;
    min-height: 48px;
    padding: 8px 10px;
    border: 1px solid var(--line-2);
    color: var(--fg-2);
    background: var(--bg-1);
    box-shadow: var(--shadow-2);
    font: 650 11px/1 var(--font-body);
    cursor: pointer;
  }
  .cookie-settings-button[hidden] { display: none; }
  .cookie-settings-button:hover,
  .cookie-settings-button:focus-visible { color: var(--ks-red); border-color: var(--ks-red); outline: none; }

  @media (max-width: 760px) {
    .cookie-consent {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 20px;
    }
    .cookie-consent__copy p { font-size: 14px; }
    .cookie-consent__actions { display: grid; grid-template-columns: 1fr; }
    .cookie-consent__button { width: 100%; }
  }
</style>
