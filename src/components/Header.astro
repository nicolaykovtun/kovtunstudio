---
interface NavChild {
  href: string;
  label: string;
  desc?: string;
  image?: string;
}
interface NavItem { href: string; label: string; children?: NavChild[] }
interface Props {
  nav: NavItem[];
  phone: string;        // отображаемый формат "+7 908 449-72-60"
  phoneTel: string;     // tel-формат "+79084497260"
  telegramUrl: string;
  maxUrl: string;
}
const { nav, phone, phoneTel, telegramUrl, maxUrl } = Astro.props;

// Подсветка активного пункта меню («где я нахожусь») — сравниваем только
// реальные адреса страниц. Якоря (#faq, #contact) не считаем отдельной
// страницей и не подсвечиваем: они не отвечают на этот вопрос однозначно.
const currentPath = Astro.url.pathname;
const currentSearch = Astro.url.search;
const normalize = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const isPageMatch = (href: string) => {
  if (href.includes('#')) return false;
  const [hrefPath, hrefQuery] = href.split('?');
  if (normalize(hrefPath) !== normalize(currentPath)) return false;
  // Ссылки с query (например /portfolio/?direction=web) должны совпасть
  // и по нему — иначе все направления подсветятся разом на /portfolio/.
  return hrefQuery ? `?${hrefQuery}` === currentSearch : true;
};
const isItemActive = (item: NavItem) =>
  isPageMatch(item.href) || (item.children?.some(child => isPageMatch(child.href)) ?? false);
---
<header class="k-header">
  <div class="container-wide row">
    <a class="brand" href="/" aria-label="Kovtun.studio — на главную">
      <img class="logo-dark"  src="/assets/logo.svg"         alt="Kovtun.studio">
      <img class="logo-light" src="/assets/logo-on-dark.svg" alt="Kovtun.studio">
    </a>
    <nav aria-label="Главная навигация">
      {nav.map(item => (
        item.children ? (
          <div class="nav-item nav-item--mega">
            <a href={item.href} aria-current={isItemActive(item) ? 'page' : undefined}>{item.label}</a>
            <div class="mega-dropdown">
              <div class="mega-dropdown__inner">
                <div class="mega-tabs" data-mega-tabs>
                  <span class="mega-tabs__indicator" aria-hidden="true"></span>
                  {item.children.map((child, i) => (
                    <a
                      href={child.href}
                      class="mega-tab"
                      data-mega-tab={i}
                      aria-current={isPageMatch(child.href) ? 'page' : undefined}
                    >
                      <span class="mega-tab__title">{child.label}</span>
                      {child.desc && <span class="mega-tab__desc">{child.desc}</span>}
                    </a>
                  ))}
                </div>
                <div class="mega-preview" data-mega-preview>
                  {item.children.map((child, i) => (
                    <a href={child.href} class="mega-preview__item" data-mega-panel={i}>
                      <span class="mega-preview__frame">
                        {child.image ? (
                          <img src={child.image} alt="" loading="lazy" width="480" height="300" />
                        ) : (
                          <span class="mega-preview__soon">
                            <span class="mega-preview__soon-label">Скоро</span>
                          </span>
                        )}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isItemActive(item) ? 'page' : undefined}>{item.label}</a>
        )
      ))}
    </nav>
    <div class="actions">
      <a href={`tel:${phoneTel}`} class="btn btn-primary" aria-label={`Позвонить ${phone}`}>
        {phone}
      </a>
      <button
        type="button"
        class="card-nav-toggle"
        id="card-nav-toggle"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="card-nav-panel"
      >
        <span class="card-nav-toggle__line"></span>
        <span class="card-nav-toggle__line"></span>
      </button>
    </div>
  </div>

  <div class="card-nav-panel" id="card-nav-panel" aria-hidden="true">
    <div class="card-nav-panel__inner container-wide">
      <div class="nav-card nav-card--dark">
        <div class="nav-card__label">Навигация</div>
        <div class="nav-card__links">
          {nav.map(item => (
            <>
              <a href={item.href} class="nav-card__link" aria-current={isItemActive(item) ? 'page' : undefined}>
                {item.label}
                <span class="nav-card__arrow" aria-hidden="true">↗</span>
              </a>
              {item.children && (
                <div class="nav-card__sublinks">
                  {item.children.map(child => (
                    <a href={child.href} class="nav-card__sublink" aria-current={isPageMatch(child.href) ? 'page' : undefined}>
                      {child.label}
                      <span class="nav-card__arrow" aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </>
          ))}
        </div>
      </div>
      <div class="nav-card nav-card--red">
        <div class="nav-card__label">Связь</div>
        <div class="nav-card__links">
          <a href={`tel:${phoneTel}`} class="nav-card__link">
            {phone}
            <span class="nav-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a href={telegramUrl} target="_blank" rel="noopener" class="nav-card__link">
            Telegram
            <span class="nav-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a href={maxUrl} target="_blank" rel="noopener" class="nav-card__link">
            MAX
            <span class="nav-card__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    var toggle = document.getElementById('card-nav-toggle');
    var panel = document.getElementById('card-nav-panel');
    if (!toggle || !panel) return;

    var isOpen = false;

    function openPanel() {
      var target = panel.scrollHeight;
      panel.style.height = target + 'px';
    }

    function closePanel() {
      // зафиксировать текущую высоту, затем в следующем кадре анимировать в 0
      panel.style.height = panel.scrollHeight + 'px';
      requestAnimationFrame(function () {
        panel.style.height = '0px';
      });
    }

    panel.addEventListener('transitionend', function (e) {
      if (e.propertyName !== 'height') return;
      if (isOpen) panel.style.height = 'auto';
    });

    toggle.addEventListener('click', function () {
      isOpen = !isOpen;
      toggle.classList.toggle('is-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      panel.setAttribute('aria-hidden', String(!isOpen));
      panel.classList.toggle('is-open', isOpen);
      if (isOpen) {
        openPanel();
      } else {
        closePanel();
      }
    });

    // Закрыть при клике по ссылке в панели (например, якорь на текущей странице)
    panel.querySelectorAll('.nav-card__link').forEach(function (link) {
      link.addEventListener('click', function () {
        if (!isOpen) return;
        isOpen = false;
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        panel.classList.remove('is-open');
        closePanel();
      });
    });

    // При ресайзе на десктоп — сбросить инлайн-высоту, чтобы не мешала
    window.addEventListener('resize', function () {
      if (window.matchMedia('(min-width: 901px)').matches) {
        panel.style.height = '';
        panel.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        isOpen = false;
      }
    });
  })();
</script>

<script>
  // Мега-дропдаун «Услуги»: наведение/фокус на пункт переключает превью
  // справа и двигает подложку-индикатор за курсором (как shifting-tabs).
  (function () {
    var tabsWrap = document.querySelector('[data-mega-tabs]');
    var previewWrap = document.querySelector('[data-mega-preview]');
    if (!tabsWrap || !previewWrap) return;

    var tabs = Array.prototype.slice.call(tabsWrap.querySelectorAll('[data-mega-tab]'));
    var panels = Array.prototype.slice.call(previewWrap.querySelectorAll('[data-mega-panel]'));
    var indicator = tabsWrap.querySelector('.mega-tabs__indicator');
    var activeIndex = 0;
    var matchedCurrent = false;

    tabs.forEach(function (tab, i) {
      if (tab.getAttribute('aria-current') === 'page') { activeIndex = i; matchedCurrent = true; }
    });
    // Ни один пункт не активен (мы не на одной из страниц-направлений) —
    // открываем превью на первом пункте с реальной картинкой кейса,
    // а не на плейсхолдере «Скоро».
    if (!matchedCurrent) {
      for (var i = 0; i < panels.length; i++) {
        if (panels[i].querySelector('img')) { activeIndex = i; break; }
      }
    }

    function setActive(index) {
      activeIndex = index;
      tabs.forEach(function (tab, i) { tab.classList.toggle('is-hover', i === index); });
      panels.forEach(function (panel, i) { panel.classList.toggle('is-active', i === index); });
      var tab = tabs[index];
      if (tab && indicator) {
        indicator.style.transform = 'translateY(' + tab.offsetTop + 'px)';
        indicator.style.height = tab.offsetHeight + 'px';
        indicator.style.opacity = '1';
      }
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('mouseenter', function () { setActive(i); });
      tab.addEventListener('focus', function () { setActive(i); });
    });

    // Начальная позиция индикатора (без анимации первого прыжка)
    function placeInitial() {
      indicator.style.transition = 'none';
      setActive(activeIndex);
      // вернуть анимацию на следующий кадр
      requestAnimationFrame(function () {
        indicator.style.transition = '';
      });
    }
    placeInitial();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(placeInitial);
    }
    window.addEventListener('resize', function () { setActive(activeIndex); });
  })();
</script>
