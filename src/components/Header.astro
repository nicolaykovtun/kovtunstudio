---
interface NavChild {
  href: string;
  label: string;
  desc?: string;
  image?: string;
}
interface NavItem { href: string; label: string; children?: NavChild[] }
interface Props {
  nav: NavItem[];
  phone: string;        // отображаемый формат "+7 908 449-72-60"
  phoneTel: string;     // tel-формат "+79084497260"
  telegramUrl: string;
  maxUrl: string;
}
const { nav, phone, phoneTel, telegramUrl, maxUrl } = Astro.props;

// Подсветка активного пункта меню («где я нахожусь») — сравниваем только
// реальные адреса страниц. Якоря (#faq, #contact) не считаем отдельной
// страницей и не подсвечиваем: они не отвечают на этот вопрос однозначно.
const currentPath = Astro.url.pathname;
const currentSearch = Astro.url.search;
const normalize = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const isPageMatch = (href: string) => {
  if (href.includes('#')) return false;
  const [hrefPath, hrefQuery] = href.split('?');
  if (normalize(hrefPath) !== normalize(currentPath)) return false;
  // Ссылки с query (например /portfolio/?direction=web) должны совпасть
  // и по нему — иначе все направления подсветятся разом на /portfolio/.
  return hrefQuery ? `?${hrefQuery}` === currentSearch : true;
};
const isItemActive = (item: NavItem) =>
  isPageMatch(item.href) || (item.children?.some(child => isPageMatch(child.href)) ?? false);

// У пункта-кнопки своей страницы нет, поэтому «где я нахожусь» для него
// определяют только дочерние ссылки. Иначе «Услуги» с href="/" горели бы
// красным на главной, хотя кнопка никуда не ведет.
const isTriggerActive = (item: NavItem) =>
  item.children?.some(child => isPageMatch(child.href)) ?? false;

// Пункты с вложенными ссылками получают панель мега-меню. Панели лежат
// не внутри пункта, а одним блоком под строкой шапки: так они занимают
// всю ширину и при переходе с одного пункта на другой не закрываются,
// а меняют высоту. Индекс пункта связывает кнопку и ее панель.
const megaItems = nav
  .map((item, index) => ({ item, index }))
  .filter(entry => entry.item.children && entry.item.children.length > 0);
---
<header class="k-header">
  <div class="container-wide row">
    <a class="brand" href="/" aria-label="Kovtun.studio — на главную">
      <img class="logo-dark"  src="/assets/logo.svg"         alt="Kovtun.studio">
      <img class="logo-light" src="/assets/logo-on-dark.svg" alt="Kovtun.studio">
    </a>
    <nav aria-label="Главная навигация">
      {nav.map((item, index) => (
        item.children && item.children.length > 0 ? (
          <button
            type="button"
            class:list={['nav-trigger', { 'is-current': isTriggerActive(item) }]}
            data-mega-trigger={index}
            aria-expanded="false"
            aria-controls={`mega-panel-${index}`}
          >
            {item.label}
            <svg class="nav-trigger__chevron" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
              <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        ) : (
          <a href={item.href} aria-current={isItemActive(item) ? 'page' : undefined}>{item.label}</a>
        )
      ))}
    </nav>
    <div class="actions">
      <a href={`tel:${phoneTel}`} class="btn btn-primary" aria-label={`Позвонить ${phone}`}>
        {phone}
      </a>
      <button
        type="button"
        class="card-nav-toggle"
        id="card-nav-toggle"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="card-nav-panel"
      >
        <span class="card-nav-toggle__line"></span>
        <span class="card-nav-toggle__line"></span>
      </button>
    </div>
  </div>

  {megaItems.length > 0 && (
    <!-- Мега-меню: одна раскрывающаяся полоса под строкой шапки. Панели
         пунктов сложены в одну клетку грида, поэтому переход с «Услуг» на
         другой пункт не закрывает меню, а меняет его высоту. Высоту в
         пикселях ставит JS: анимировать height: auto браузер не умеет. -->
    <div class="mega" data-mega aria-hidden="true">
      <div class="mega__stack">
        {megaItems.map(({ item, index }) => (
          <div class="mega__panel" id={`mega-panel-${index}`} data-mega-panel={index} inert>
            <div class="container-wide mega__grid">
              {item.children!.map(child => (
                <a class="mega-card" href={child.href} aria-current={isPageMatch(child.href) ? 'page' : undefined}>
                  <span class="mega-card__frame">
                    {child.image ? (
                      <img src={child.image} alt="" loading="lazy" width="480" height="270" />
                    ) : (
                      <span class="mega-card__soon">
                        <span class="mega-card__soon-label">Скоро</span>
                      </span>
                    )}
                  </span>
                  <span class="mega-card__meta">
                    <span class="mega-card__text">
                      <span class="mega-card__title">{child.label}</span>
                      {child.desc && <span class="mega-card__desc">{child.desc}</span>}
                    </span>
                    <span class="mega-card__arrow" aria-hidden="true">
                      <svg viewBox="0 0 14 14" focusable="false">
                        <path d="M3 11L11 3M11 3H4.6M11 3v6.4" fill="none" stroke="currentColor"
                              stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Закрытая панель свернута через height: 0 и overflow: hidden, но ссылки
       внутри остаются в потоке и ловят фокус табом. Для aria-hidden это
       нарушение: скринридер элемент не видит, а фокус в него попадает.
       Атрибут inert выключает и фокус, и дерево доступности; JS снимает его
       при открытии. -->
  <div class="card-nav-panel" id="card-nav-panel" aria-hidden="true" inert>
    <div class="card-nav-panel__inner container-wide">
      <div class="nav-card nav-card--dark">
        <div class="nav-card__label">Навигация</div>
        <div class="nav-card__links">
          {nav.map(item => (
            <>
              <a href={item.href} class="nav-card__link" aria-current={isItemActive(item) ? 'page' : undefined}>
                {item.label}
                <span class="nav-card__arrow" aria-hidden="true">↗</span>
              </a>
              {item.children && (
                <div class="nav-card__sublinks">
                  {item.children.map(child => (
                    <a href={child.href} class="nav-card__sublink" aria-current={isPageMatch(child.href) ? 'page' : undefined}>
                      {child.label}
                      <span class="nav-card__arrow" aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </>
          ))}
        </div>
      </div>
      <div class="nav-card nav-card--red">
        <div class="nav-card__label">Связь</div>
        <div class="nav-card__links">
          <a href={`tel:${phoneTel}`} class="nav-card__link">
            {phone}
            <span class="nav-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a href={telegramUrl} target="_blank" rel="noopener" class="nav-card__link">
            Telegram
            <span class="nav-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a href={maxUrl} target="_blank" rel="noopener" class="nav-card__link">
            MAX
            <span class="nav-card__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    var toggle = document.getElementById('card-nav-toggle');
    var panel = document.getElementById('card-nav-panel');
    if (!toggle || !panel) return;

    var isOpen = false;

    function openPanel() {
      var target = panel.scrollHeight;
      panel.style.height = target + 'px';
    }

    function closePanel() {
      // зафиксировать текущую высоту, затем в следующем кадре анимировать в 0
      panel.style.height = panel.scrollHeight + 'px';
      requestAnimationFrame(function () {
        panel.style.height = '0px';
      });
    }

    panel.addEventListener('transitionend', function (e) {
      if (e.propertyName !== 'height') return;
      if (isOpen) panel.style.height = 'auto';
    });

    toggle.addEventListener('click', function () {
      isOpen = !isOpen;
      toggle.classList.toggle('is-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      panel.setAttribute('aria-hidden', String(!isOpen));
      panel.toggleAttribute('inert', !isOpen);
      panel.classList.toggle('is-open', isOpen);
      if (isOpen) {
        openPanel();
      } else {
        closePanel();
      }
    });

    // Закрыть при клике по ссылке в панели (например, якорь на текущей странице)
    panel.querySelectorAll('.nav-card__link').forEach(function (link) {
      link.addEventListener('click', function () {
        if (!isOpen) return;
        isOpen = false;
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        panel.setAttribute('inert', '');
        panel.classList.remove('is-open');
        closePanel();
      });
    });

    // При ресайзе на десктоп — сбросить инлайн-высоту, чтобы не мешала
    window.addEventListener('resize', function () {
      if (window.matchMedia('(min-width: 901px)').matches) {
        panel.style.height = '';
        panel.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        isOpen = false;
      }
    });
  })();
</script>

<script>
  // Мега-меню шапки: наведение на пункт со стрелкой раскрывает полосу с
  // карточками направлений. Переход на соседний такой пункт не закрывает
  // полосу — она меняет высоту под новую панель. Уводим курсор из шапки
  // (или Esc) — закрывается.
  (function () {
    var header = document.querySelector('.k-header');
    var mega = document.querySelector('[data-mega]');
    if (!header || !mega) return;

    var triggers = Array.prototype.slice.call(header.querySelectorAll('[data-mega-trigger]'));
    var panels = Array.prototype.slice.call(mega.querySelectorAll('[data-mega-panel]'));
    var plainLinks = Array.prototype.slice.call(header.querySelectorAll('nav a'));
    if (!triggers.length || !panels.length) return;

    var openIndex = -1;

    function panelFor(index) {
      for (var i = 0; i < panels.length; i++) {
        if (panels[i].getAttribute('data-mega-panel') === String(index)) return panels[i];
      }
      return null;
    }

    function open(index) {
      var panel = panelFor(index);
      if (!panel || openIndex === index) return;
      openIndex = index;

      panels.forEach(function (p) {
        var isActive = p === panel;
        p.classList.toggle('is-active', isActive);
        p.toggleAttribute('inert', !isActive);
      });
      triggers.forEach(function (t) {
        var isActive = t.getAttribute('data-mega-trigger') === String(index);
        t.classList.toggle('is-open', isActive);
        t.setAttribute('aria-expanded', String(isActive));
      });

      header.classList.add('has-mega-open');
      mega.setAttribute('aria-hidden', 'false');
      mega.style.height = panel.offsetHeight + 'px';
    }

    function close() {
      if (openIndex === -1) return;
      openIndex = -1;
      panels.forEach(function (p) {
        p.classList.remove('is-active');
        p.setAttribute('inert', '');
      });
      triggers.forEach(function (t) {
        t.classList.remove('is-open');
        t.setAttribute('aria-expanded', 'false');
      });
      header.classList.remove('has-mega-open');
      mega.setAttribute('aria-hidden', 'true');
      mega.style.height = '0px';
    }

    // Мышь есть — работает наведение. На тач-устройстве браузер подделывает
    // mouseenter при тапе, и панель открывалась бы и тут же закрывалась
    // кликом, поэтому там оставляем только клик.
    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    triggers.forEach(function (trigger) {
      var index = Number(trigger.getAttribute('data-mega-trigger'));
      if (canHover) {
        trigger.addEventListener('mouseenter', function () { open(index); });
      }
      // Клик — для клавиатуры и тач-устройств, где наведения нет.
      trigger.addEventListener('click', function () {
        if (openIndex === index) close(); else open(index);
      });
    });

    if (canHover) {
      // Наведение на пункт без вложенных ссылок закрывает раскрытую полосу:
      // иначе она висит над страницей, пока курсор гуляет по шапке.
      plainLinks.forEach(function (link) {
        link.addEventListener('mouseenter', close);
      });
      header.addEventListener('mouseleave', close);
    } else {
      // Тап мимо шапки — закрыть.
      document.addEventListener('click', function (e) {
        if (openIndex === -1 || header.contains(e.target)) return;
        close();
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || openIndex === -1) return;
      var trigger = header.querySelector('[data-mega-trigger="' + openIndex + '"]');
      close();
      if (trigger) trigger.focus();
    });

    // Ушли фокусом за пределы шапки (таб из последней карточки) — закрыть.
    header.addEventListener('focusout', function (e) {
      if (!e.relatedTarget || header.contains(e.relatedTarget)) return;
      close();
    });

    // Высота полосы задана в пикселях, а содержимое панели может стать выше
    // уже после открытия: догрузился шрифт и подписи перенеслись иначе,
    // догрузилась картинка, изменилась ширина окна. Наблюдатель ловит все
    // три случая — иначе низ карточек обрезался.
    function resync() {
      if (openIndex === -1) return;
      var panel = panelFor(openIndex);
      if (panel) mega.style.height = panel.offsetHeight + 'px';
    }
    if (window.ResizeObserver) {
      var observer = new ResizeObserver(resync);
      panels.forEach(function (p) { observer.observe(p); });
    } else {
      window.addEventListener('resize', resync);
      mega.querySelectorAll('img').forEach(function (img) {
        img.addEventListener('load', resync);
      });
    }
  })();
</script>
