<style is:global>
.kv-logo{display:block;height:var(--kv-h,40px);width:auto;overflow:visible;--kv-ink:#444443;--kv-dot:#D91620}
.kv-logo .kv-ink{fill:var(--kv-ink)}
.kv-logo .kv-red{fill:var(--kv-dot)}
.kv-logo .kv-anim{opacity:0}
.kv-logo .kv-s{fill:none;stroke:#fff;stroke-linecap:butt;stroke-linejoin:round;stroke-dasharray:1 1;stroke-dashoffset:0}
.kv-logo .kv-pop{transform-box:fill-box;transform-origin:center}
/* Как у Logitech: при наведении знак исчезает и за 1,2 с прорисовывается штрихами; убрали мышь — сразу целый.
   В покое виден kv-plain: те же пути, что в logo.svg, без маски. kv-anim с маской виден только во время анимации. */
:hover>.kv-logo .kv-s{animation:kv-draw .62s cubic-bezier(.3,.1,.3,1) both}
:hover>.kv-logo .kv-anim{animation:kv-on 1.2s linear both}
:hover>.kv-logo .kv-plain{animation:kv-back 1.2s linear both}
:hover>.kv-logo .kv-pop{animation:kv-pop .5s cubic-bezier(.3,.1,.3,1) .55s both}
@keyframes kv-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
@keyframes kv-on{0%,55%{opacity:1}56%,100%{opacity:0}}
@keyframes kv-back{0%,55%{opacity:0}56%,100%{opacity:1}}
@keyframes kv-pop{0%{opacity:0;transform:scale(.2)}40%{opacity:1}100%{opacity:1;transform:scale(1)}}
@media (prefers-reduced-motion:reduce){:hover>.kv-logo .kv-s,:hover>.kv-logo .kv-anim,:hover>.kv-logo .kv-plain,:hover>.kv-logo .kv-pop{animation:none}}
</style>
